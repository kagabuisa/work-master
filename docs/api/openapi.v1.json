  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque mobile access or integration token; reject ambiguous cookie/bearer authentication."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "Refresh": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ]
      },
      "PasswordChange": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "current_password": {
            "type": "string",
            "format": "password"
          },
          "new_password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "current_password",
          "new_password"
        ]
      },
      "Tokens": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "access_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "minimum": 1
          },
          "password_change_required": {
            "type": "boolean"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "expires_in",
          "password_change_required"
        ]
      },
      "Me": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "username": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "credential_scopes": {
            "type": "array",
            "nullable": true,
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "username",
          "capabilities",
          "credential_scopes"
        ]
      },
      "Acknowledgement": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ]
      },
      "IntegrationCreate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64
          },
          "role": {
            "type": "string",
            "maxLength": 64
          },
          "scopes": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "enum": [
                "masters:read",
                "stock:read",
                "invoices:read",
                "invoices:create",
                "invoices:submit",
                "payments:record"
              ]
            }
          }
        },
        "required": [
          "username",
          "role",
          "scopes"
        ]
      },
      "CredentialIssue": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "scopes": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "enum": [
                "masters:read",
                "stock:read",
                "invoices:read",
                "invoices:create",
                "invoices:submit",
                "payments:record"
              ]
            }
          }
        },
        "required": [
          "user_id",
          "scopes"
        ]
      },
      "Credential": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "description": "Shown only in this issuance response; never retrievable later."
          },
          "scopes": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "enum": [
                "masters:read",
                "stock:read",
                "invoices:read",
                "invoices:create",
                "invoices:submit",
                "payments:record"
              ]
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "user_id",
          "token",
          "scopes",
          "expires_at"
        ]
      },
      "CredentialMetadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "user_id": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "string",
              "enum": [
                "masters:read",
                "stock:read",
                "invoices:read",
                "invoices:create",
                "invoices:submit",
                "payments:record"
              ]
            }
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "last_used_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "user_id",
          "scopes",
          "expires_at",
          "revoked_at",
          "last_used_at",
          "created_at"
        ]
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "responses": {
      "ApiError": {
        "description": "Error envelope; status determines category. Retry-After required for throttling; never expose SQL errors or stack traces.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
