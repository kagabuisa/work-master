<!doctype html>
<html lang="en">
<head>
  <title>Balance Sheet</title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell ui-page ui-page-report">
    <header class="topbar">
      <div>
        <p class="eyebrow">Accounting</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Home', href: '/' }, { label: 'Reports', href: availableReports[0]?.href || '/reports/balance-sheet' }, { label: 'Balance Sheet' }] }) %>
      </div>
      <nav>
        <%- include('module-nav', { activeModule: 'report' }) %>
      </nav>
    </header>

    <section class="metrics ui-report-metrics">
      <article><span>Assets</span><strong><%= money(report.summary.total_assets) %></strong></article>
      <article><span>Liabilities + Equity</span><strong><%= money(report.summary.liabilities_plus_equity) %></strong></article>
      <article><span>Status</span><strong><%= report.summary.is_balanced ? 'Balanced' : `Off by ${money(report.summary.difference)}` %></strong></article>
    </section>

    <form class="report-filters ui-toolbar ui-filter-row" method="get">
      <label>As Of<input type="date" name="as_of" value="<%= report.filters.as_of %>"></label>
      <div class="report-filter-actions">
        <button type="submit">Apply</button>
        <a class="button button-light" href="/reports/balance-sheet">Reset</a>
      </div>
    </form>

    <section class="grid">
      <div class="ui-surface">
        <div class="section-title ui-section-heading">
          <h2>Assets</h2>
          <strong><%= money(report.summary.total_assets) %></strong>
        </div>
        <div class="ui-table-scroll" role="region" aria-label="Balance Sheet table" tabindex="0"><table class="ui-table">
          <thead><tr><th class="row-number">#</th><th>Account</th><th class="ui-amount">Amount</th></tr></thead>
          <tbody>
            <% if (!report.assets.length) { %>
              <tr><td colspan="3" class="empty">No asset balances found.</td></tr>
            <% } %>
            <% report.assets.forEach((row, index) => { %>
              <tr>
                <td class="row-number"><%= index + 1 %></td>
                <td>
                  <% if (row.account_code) { %><strong><%= row.account_code %></strong><% } %>
                  <small><%= row.account_name %></small>
                </td>
                <td class="ui-amount"><%= money(row.amount) %></td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot><tr><th colspan="2">Total Assets</th><th><%= money(report.summary.total_assets) %></th></tr></tfoot>
        </table></div>
      </div>

      <div class="ui-surface">
        <div class="section-title ui-section-heading">
          <h2>Liabilities</h2>
          <strong><%= money(report.summary.total_liabilities) %></strong>
        </div>
        <div class="ui-table-scroll" role="region" aria-label="Balance Sheet table" tabindex="0"><table class="ui-table">
          <thead><tr><th class="row-number">#</th><th>Account</th><th class="ui-amount">Amount</th></tr></thead>
          <tbody>
            <% if (!report.liabilities.length) { %>
              <tr><td colspan="3" class="empty">No liability balances found.</td></tr>
            <% } %>
            <% report.liabilities.forEach((row, index) => { %>
              <tr>
                <td class="row-number"><%= index + 1 %></td>
                <td>
                  <% if (row.account_code) { %><strong><%= row.account_code %></strong><% } %>
                  <small><%= row.account_name %></small>
                </td>
                <td class="ui-amount"><%= money(row.amount) %></td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot><tr><th colspan="2">Total Liabilities</th><th><%= money(report.summary.total_liabilities) %></th></tr></tfoot>
        </table></div>

        <div class="section-title report-section ui-section-heading">
          <h2>Equity</h2>
          <strong><%= money(report.summary.total_equity) %></strong>
        </div>
        <div class="ui-table-scroll" role="region" aria-label="Balance Sheet table" tabindex="0"><table class="ui-table">
          <thead><tr><th class="row-number">#</th><th>Account</th><th class="ui-amount">Amount</th></tr></thead>
          <tbody>
            <% if (!report.equity.length) { %>
              <tr><td colspan="3" class="empty">No equity balances found.</td></tr>
            <% } %>
            <% report.equity.forEach((row, index) => { %>
              <tr>
                <td class="row-number"><%= index + 1 %></td>
                <td>
                  <% if (row.account_code) { %><strong><%= row.account_code %></strong><% } %>
                  <small><%= row.account_name %></small>
                </td>
                <td class="ui-amount"><%= money(row.amount) %></td>
              </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr><th colspan="2">Total Equity</th><th><%= money(report.summary.total_equity) %></th></tr>
            <tr><th colspan="2">Liabilities + Equity</th><th><%= money(report.summary.liabilities_plus_equity) %></th></tr>
          </tfoot>
        </table></div>
      </div>
    </section>
  </main>
</body>
</html>
