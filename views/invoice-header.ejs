<header class="invoice-document-header">
  <div class="invoice-header-company">
    <%- include('invoice-company') %>
  </div>
  <div class="invoice-voucher-info">
    <h1><%= voucherTitle %></h1>
    <% if (typeof showVoucherNumber === 'undefined' || showVoucherNumber) { %><p><%= invoice.invoice_no %></p><% } %>
    <% if (invoice.non_system_invoice) { %><p>Ext Invoice: <%= invoice.non_system_invoice %></p><% } %>
  </div>
</header>
