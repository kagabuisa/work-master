<% if (pagination && pagination.total > pagination.limit) { %>
  <% const params = new URLSearchParams(query || {}); %>
  <% const pageSize = pagination.limit; %>
  <% const totalPages = pagination.total_pages; %>
  <% const currentPage = pagination.page; %>
  <% const pageHref = (page) => {
    params.set('page', String(page));
    params.set('page_size', String(pageSize));
    return `${basePath || ''}?${params.toString()}`;
  }; %>
  <nav class="server-pagination" aria-label="Pagination">
    <span><%= pagination.start %>-<%= pagination.end %> of <%= pagination.total %></span>
    <% if (currentPage <= 1) { %><span class="button button-light disabled" aria-disabled="true">Prev</span><% } else { %><a class="button button-light" href="<%= pageHref(currentPage - 1) %>">Prev</a><% } %>
    <span>Page <%= currentPage %> of <%= totalPages %></span>
    <% if (currentPage >= totalPages) { %><span class="button button-light disabled" aria-disabled="true">Next</span><% } else { %><a class="button button-light" href="<%= pageHref(currentPage + 1) %>">Next</a><% } %>
  </nav>
<% } %>
