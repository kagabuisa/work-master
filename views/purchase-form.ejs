<!doctype html>
<html lang="en">
<head>
  <title><%= purchase.id ? 'Edit Purchase' : 'New Purchase Invoice' %></title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">Purchases</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Home', href: '/' }, { label: 'Purchases', href: '/purchases' }, { label: 'Purchase Invoices', href: '/purchases' }, { label: purchase.id ? 'Edit Purchase Invoice' : 'New Purchase Invoice' }] }) %>
      </div>
      <nav><%- include('module-nav', { activeModule: 'purchases' }) %></nav>
    </header>
    <% if (error) { %><section class="notice warning"><strong><%= error %></strong></section><% } %>
    <% if (!purchase.purchase_order_id && typeof purchaseOrders !== 'undefined' && purchaseOrders.length) { %>
      <form method="get" action="<%= purchase.id ? `/purchases/${purchase.id}/edit` : '/purchases/new' %>" class="invoice-card report-filters">
        <label>Receive from Purchase Order<select name="purchase_order_id" required><option value="">Choose a submitted order</option><% purchaseOrders.forEach((order) => { %><option value="<%= order.id %>"><%= order.order_no %> · <%= order.supplier_name %></option><% }) %></select></label>
        <button type="submit">Load Order Items</button>
        <% if (purchase.id) { %><p>Loading an order replaces the current draft items and supplier when you save.</p><% } %>
      </form>
    <% } %>
    <% if (purchase.purchase_order_id) { %><p>Receiving from <% if (can('vouchers.purchase-orders.view')) { %><a href="/purchase-orders/<%= purchase.purchase_order_id %>"><%= purchase.purchase_order_no || `PO-${String(purchase.purchase_order_id).padStart(6, '0')}` %></a><% } else { %><%= purchase.purchase_order_no || `PO-${String(purchase.purchase_order_id).padStart(6, '0')}` %><% } %>. Adjust quantities to match what arrived.</p><% } %>
    <form method="post" action="<%= purchase.id ? `/purchases/${purchase.id}` : '/purchases' %>" class="invoice-form entry-form" id="purchase-form" data-static-labels data-voucher-form data-purchase-order-id="<%= purchase.purchase_order_id || '' %>">
      <input type="hidden" name="purchase_order_id" value="<%= purchase.purchase_order_id || '' %>">
      <datalist id="purchase-suppliers"></datalist>
      <datalist id="purchase-items-list"></datalist>
      <datalist id="purchase-warehouses"></datalist>
      <section class="form-grid">
        <label>Purchase Date<input type="date" name="posting_date" value="<%= purchase.posting_date || '' %>" required></label>
        <label>Posting Time<input type="time" name="posting_time" value="<%= purchase.posting_time !== undefined ? purchase.posting_time : currentPostingTime() %>" required></label>
        <label>Due Date<input type="date" name="due_date" value="<%= purchase.due_date || '' %>"></label>
        <label>Supplier name<input name="supplier_id" id="purchase-supplier" list="purchase-suppliers" autocomplete="off" value="<%= purchase.supplier_id || '' %>" <%= purchase.purchase_order_id ? 'readonly' : '' %> required></label>
        <label>Price List<% if (purchase.purchase_order_id) { %><input type="hidden" name="price_list" value="<%= purchase.price_list || '' %>"><% } %><select name="<%= purchase.purchase_order_id ? '' : 'price_list' %>" id="purchase-price-list" <%= purchase.purchase_order_id ? 'disabled' : 'required' %>><option value="<%= purchase.price_list || '' %>"><%= purchase.price_list || 'Loading price lists...' %></option></select></label>
        <%- include('cost-center-field', { value: purchase.cost_center, readOnly: false }) %>
        <label>Supplier Invoice / Reference<input name="supplier_reference" value="<%= purchase.supplier_reference || '' %>"></label>
        <label class="wide">Remarks<input name="remarks" value="<%= purchase.remarks || '' %>"></label>
      </section>
      <div id="purchase-lookup-status" class="notice" hidden>
        <p role="status" data-lookup-message></p>
        <button type="button" class="button-light" data-lookup-retry hidden>Retry lookup</button>
      </div>
      <div class="entry-table-scroll" role="region" aria-label="Purchase items" tabindex="0">
      <table class="editable entry-table" id="purchase-items">
        <thead><tr><th>#</th><th>Item Code</th><th>Item Name</th><th>Warehouse</th><th>Qty</th><th>Unit Cost</th><th>Total</th><th></th></tr></thead>
        <tbody>
          <% (purchase.items && purchase.items.length ? purchase.items : [{}]).forEach((item, index) => { %>
            <tr>
              <td class="row-number" data-label="Item"><%= index + 1 %></td>
              <td data-label="Item Code"><input type="hidden" name="item_id" value="<%= item.id || '' %>"><input type="hidden" name="purchase_order_item_id" value="<%= item.purchase_order_item_id || '' %>"><input aria-label="Item Code" name="item_code" list="purchase-items-list" autocomplete="off" value="<%= item.item_code || '' %>" <%= purchase.purchase_order_id ? 'readonly' : '' %> required></td>
              <td data-label="Item Name"><input aria-label="Item Name" name="item_name" value="<%= item.item_name || '' %>" readonly></td>
              <td data-label="Warehouse"><input aria-label="Warehouse" name="warehouse" list="purchase-warehouses" autocomplete="off" value="<%= item.warehouse || '' %>" <%= purchase.purchase_order_id ? 'readonly' : '' %> required></td>
              <td data-label="Qty"><input aria-label="Qty" name="quantity" type="number" min="0.001" step="0.001" value="<%= item.quantity || '' %>" required></td>
              <td data-label="Unit Cost"><input aria-label="Unit Cost" name="unit_price" type="number" min="0.01" step="0.01" value="<%= item.unit_price != null ? item.unit_price : '' %>" required></td>
              <td class="purchase-line-total" data-label="Total"><%= item.line_total || 0 %></td>
              <td class="entry-row-actions"><button type="button" class="button-light" data-remove-purchase-row>Remove</button></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
      <div class="actions">
        <button type="button" class="button-light" id="add-purchase-row" <%= purchase.purchase_order_id ? 'hidden' : '' %>>Add Item</button>
        <div class="live-total"><span>Total</span><strong id="purchase-total">Ugx 0</strong></div>
        <button type="submit" data-voucher-save>Save</button>
      </div>
    </form>
  </main>
  <script src="/purchase-form.js?v=<%= assetVersion %>"></script>
  <script src="/cost-center-field.js?v=<%= assetVersion %>"></script>
</body>
</html>
