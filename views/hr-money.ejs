<div class="hr-money-workspace" data-static-labels>
<% const moneyKindLabels={advance:'Salary advance',loan:'Employee loan',recovery:'Recovery / charge',reimbursement:'Expense reimbursement'}; %>
<% if(can('hr.money.create')){ %><section class="invoice-card hr-card ui-surface"><div class="hr-money-heading ui-section-heading"><div><p class="hr-section-eyebrow">New transaction</p><div class="hr-money-title ui-section-title"><h2>Employee transaction</h2><%- include('hr-helper',{helpLabel:'Help with employee transactions',helpText:'Record an advance, loan, approved charge, or reimbursement.'}) %></div></div><span class="hr-plan-count">Saved as draft</span></div><form method="post" action="/hr/money" class="hr-money-form">
<div class="hr-money-primary-fields">
<%- include('hr-employee-select',{label:'Employee',name:'employee_id',multiple:false,activeOnly:true}) %>
<label><span class="hr-control-label">Type</span><select name="kind"><option value="advance">Salary advance</option><option value="loan">Employee loan</option><option value="recovery">Approved recovery / charge</option><option value="reimbursement">Expense reimbursement</option></select></label>
<%- include('voucher-posting-fields', { postingFields: { date: today } }) %><label><span class="hr-control-label">Amount (UGX)</span><input type="number" name="amount" min="0.01" step="0.01" required></label>
</div><div class="hr-money-account-fields"><div class="hr-money-field"><%- include('hr-account-select',{label:'Employee balance account',name:'account_id',types:['asset','liability'],details:['Receivable','Payable'],bank:false,selected:'',required:true}) %><%- include('hr-helper',{helpLabel:'Help with employee balance account',helpText:'Receivable asset for advances, loans, and charges; payable liability for reimbursements.'}) %></div>
<div class="hr-money-field"><%- include('hr-account-select',{label:'Offset account',name:'offset_account_id',types:['income','expense'],bank:false,selected:''}) %><%- include('hr-helper',{helpLabel:'Help with offset account',helpText:'Expense for reimbursements; income or expense for charges. Leave blank for advances and loans.'}) %></div>
<label><span class="hr-control-label">Shop / cost center</span><select name="cost_center"><option value="">Use employee assignment</option><% opts.centers.forEach(c=>{ %><option value="<%= c.cost_center %>"><%= c.cost_center_name || costCenterName(c.cost_center) %></option><% }) %></select></label></div><label class="hr-money-reason"><span class="hr-control-label">Reason / supporting reference</span><textarea name="reason" required maxlength="2000" rows="3" placeholder="Explain the transaction and include its supporting reference."></textarea></label><div class="hr-money-save ui-form-footer"><%- include('hr-helper',{helpLabel:'Help with saving and approving transactions',helpText:'Advances and loans become employee balances when paid. Charges and reimbursements are recorded on approval. A different user must approve; Admin can approve directly.'}) %><button class="button" type="submit">Save draft</button></div></form></section><% } %>
<section class="invoice-card hr-card ui-surface"><div class="hr-money-heading ui-section-heading"><div><p class="hr-section-eyebrow">Register</p><div class="hr-money-title ui-section-title"><h2>Employee balances and transactions</h2><%- include('hr-helper',{helpLabel:'Help with employee balances',helpText:'Balances are calculated from posted amounts, payments, cash returns and payroll recoveries. All permitted employee transactions are included.'}) %></div></div><span class="hr-plan-count"><%= records.length %> transactions</span></div><div class="ui-toolbar ui-filter-row"><label class="hr-money-search"><span class="hr-control-label">Find employee transaction</span><input type="search" data-hr-search placeholder="Employee, reference or reason"></label></div><div class="table-wrap ui-table-scroll"><table class="ui-table" data-hr-filter><thead><tr><th>Reference</th><th>Employee</th><th>Type</th><th>Reason</th><th>Approved amount</th><th>Disbursed / paid</th><th>Returned</th><th>Payroll recovery</th><th>Outstanding</th><th>Status</th></tr></thead><tbody><% if(!records.length){ %><tr><td colspan="10" class="empty">No employee transactions in your permitted scope.</td></tr><% } %><% records.forEach(r=>{ %><tr><td><a href="#money-<%= r.id %>">HRM-<%= r.id %></a></td><td><%= r.employee_name %></td><td><%= moneyKindLabels[r.kind]||r.kind %></td><td><%= r.reason %></td><td class="ui-amount"><%= money(r.amount) %></td><td class="ui-amount"><%= money(r.paid_out) %></td><td class="ui-amount"><%= money(r.returned) %></td><td class="ui-amount"><%= money(r.recovered) %></td><td class="hr-money-outstanding"><%= money(r.balance) %></td><td><span class="badge <%= r.docstatus %>"><%= r.docstatus %></span></td></tr><% }) %></tbody></table></div></section>
<% records.forEach(r=>{ %><section class="invoice-card hr-card ui-surface hr-money-detail" id="money-<%= r.id %>"><details><summary>HRM-<%= r.id %> · <%= r.employee_name %> · <%= moneyKindLabels[r.kind]||r.kind %> · <%= money(r.balance) %> outstanding</summary><p><%= r.reason %> · <%= formatDate(r.posting_date) %> · Created by <%= r.created_by||'Unknown' %></p><div class="hr-actions">
<% if(r.docstatus==='draft'&&can('hr.money.submit')){ %><form method="post" action="/hr/money/<%= r.id %>/submit"><button class="button">Approve</button></form><% } %>
<% if(r.docstatus!=='cancelled'&&can('hr.money.cancel')){ %><form method="post" action="/hr/money/<%= r.id %>/cancel" class="hr-inline"><%- include('voucher-posting-fields', { postingFields: { date: today, label: 'Cancellation date' } }) %><button class="button secondary" data-confirm="Cancel this employee transaction?">Cancel</button></form><% } %></div>
<% const maximum=r.kind==='reimbursement'?r.balance:Number(r.amount)-Number(r.paid_out); %>
<% if(r.docstatus==='submitted'&&can('hr.money.pay')&&r.kind!=='recovery'&&maximum>0){ %><h3><%= r.kind==='reimbursement'?'Pay reimbursement':'Disburse funds' %></h3><%- include('hr-payment-form',{action:`/hr/money/${r.id}/pay`,maximum,buttonLabel:'Record payment'}) %><% } %>
<% if(r.docstatus==='submitted'&&can('hr.money.pay')&&r.kind!=='reimbursement'&&r.balance>0){ %><h3>Cash return / repayment</h3><%- include('hr-payment-form',{action:`/hr/money/${r.id}/return`,maximum:r.balance,buttonLabel:'Record return'}) %><% } %>
<h3>Payment history</h3><div class="table-wrap ui-table-scroll"><table class="ui-table"><thead><tr><th>Date</th><th>Direction</th><th>Amount</th><th>Account</th><th>Reference</th><th>Status</th><th>Action</th></tr></thead><tbody><% (payments[r.id]||[]).forEach(p=>{ %><tr><td><%= formatDate(p.posting_date) %></td><td><%= p.direction %></td><td class="ui-amount"><%= money(p.amount) %></td><td><%= p.account_name %></td><td><%= p.reference %></td><td><%= p.docstatus %></td><td><% if(p.docstatus==='submitted'&&can('hr.money.cancel')){ %><form method="post" action="/hr/money/<%= r.id %>/cancel-payment" class="hr-inline"><input type="hidden" name="payment_id" value="<%= p.id %>"><%- include('voucher-posting-fields', { postingFields: { date: today, label: 'Reversal date' } }) %><button class="button secondary" data-confirm="Reverse this payment?">Cancel</button></form><% } %></td></tr><% }) %></tbody></table></div></details></section><% }) %>

</div>
