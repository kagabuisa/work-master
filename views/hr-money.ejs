<% if(can('hr.money.create')){ %><section class="invoice-card hr-card"><h2>New employee transaction</h2><form method="post" action="/hr/money" class="hr-grid">
<%- include('hr-employee-select',{label:'Employee',name:'employee_id',multiple:false,activeOnly:true}) %>
<label>Type<select name="kind"><option value="advance">Salary advance</option><option value="loan">Employee loan</option><option value="recovery">Approved recovery / charge</option><option value="reimbursement">Expense reimbursement</option></select></label>
<label>Date<input type="date" name="posting_date" value="<%= today %>" required></label><label>Amount (UGX)<input type="number" name="amount" min="0.01" step="0.01" required></label>
<%- include('hr-account-select',{label:'Employee balance account (asset for advances/loans/recoveries; liability for reimbursement)',name:'account_id',types:['asset','liability'],details:['Receivable','Payable'],bank:false,selected:'',required:true}) %>
<%- include('hr-account-select',{label:'Offset account (expense for reimbursement; income/expense for recovery)',name:'offset_account_id',types:['income','expense'],bank:false,selected:''}) %>
<label>Shop / cost center<select name="cost_center"><option value="">Use employee assignment</option><% opts.centers.forEach(c=>{ %><option><%= c.cost_center %></option><% }) %></select></label><label>Reason / supporting reference<textarea name="reason" required maxlength="2000"></textarea></label><div><button class="button">Save draft</button></div></form>
<p>Approval records recoveries and reimbursements. Advances and loans become employee balances only when actually paid. A different user must approve; Admin can approve directly.</p></section><% } %>
<section class="invoice-card hr-card"><h2>Employee balances and transactions</h2><p>Balances are calculated from posted amounts, payments, cash returns and payroll recoveries. All permitted employee transactions are included.</p><label>Find employee transaction<input type="search" data-hr-search placeholder="Employee, reference or reason"></label><div class="table-wrap"><table data-hr-filter><thead><tr><th>Reference</th><th>Employee</th><th>Type</th><th>Reason</th><th>Approved amount</th><th>Disbursed / paid</th><th>Returned</th><th>Payroll recovery</th><th>Outstanding</th><th>Status</th></tr></thead><tbody><% records.forEach(r=>{ %><tr><td><a href="#money-<%= r.id %>">HRM-<%= r.id %></a></td><td><%= r.employee_name %></td><td><%= r.kind %></td><td><%= r.reason %></td><td><%= money(r.amount) %></td><td><%= money(r.paid_out) %></td><td><%= money(r.returned) %></td><td><%= money(r.recovered) %></td><td><%= money(r.balance) %></td><td><%= r.docstatus %></td></tr><% }) %></tbody></table></div></section>
<% records.forEach(r=>{ %><section class="invoice-card hr-card" id="money-<%= r.id %>"><details><summary>HRM-<%= r.id %> · <%= r.employee_name %> · <%= r.kind %> · <%= money(r.balance) %> outstanding</summary><p><%= r.reason %> · <%= formatDate(r.posting_date) %> · Created by <%= r.created_by||'Unknown' %></p><div class="hr-actions">
<% if(r.docstatus==='draft'&&can('hr.money.submit')){ %><form method="post" action="/hr/money/<%= r.id %>/submit"><button class="button">Approve</button></form><% } %>
<% if(r.docstatus!=='cancelled'&&can('hr.money.cancel')){ %><form method="post" action="/hr/money/<%= r.id %>/cancel" class="hr-inline"><label>Cancellation date<input type="date" name="posting_date" value="<%= today %>" required></label><button class="button secondary" data-confirm="Cancel this employee transaction?">Cancel</button></form><% } %></div>
<% const maximum=r.kind==='reimbursement'?r.balance:Number(r.amount)-Number(r.paid_out); %>
<% if(r.docstatus==='submitted'&&can('hr.money.pay')&&r.kind!=='recovery'&&maximum>0){ %><h3><%= r.kind==='reimbursement'?'Pay reimbursement':'Disburse funds' %></h3><%- include('hr-payment-form',{action:`/hr/money/${r.id}/pay`,maximum,buttonLabel:'Record payment'}) %><% } %>
<% if(r.docstatus==='submitted'&&can('hr.money.pay')&&r.kind!=='reimbursement'&&r.balance>0){ %><h3>Cash return / repayment</h3><%- include('hr-payment-form',{action:`/hr/money/${r.id}/return`,maximum:r.balance,buttonLabel:'Record return'}) %><% } %>
<h3>Payment history</h3><table><thead><tr><th>Date</th><th>Direction</th><th>Amount</th><th>Account</th><th>Reference</th><th>Status</th><th>Action</th></tr></thead><tbody><% (payments[r.id]||[]).forEach(p=>{ %><tr><td><%= formatDate(p.posting_date) %></td><td><%= p.direction %></td><td><%= money(p.amount) %></td><td><%= p.account_name %></td><td><%= p.reference %></td><td><%= p.docstatus %></td><td><% if(p.docstatus==='submitted'&&can('hr.money.cancel')){ %><form method="post" action="/hr/money/<%= r.id %>/cancel-payment" class="hr-inline"><input type="hidden" name="payment_id" value="<%= p.id %>"><label>Reversal date<input type="date" name="posting_date" value="<%= today %>" required></label><button class="button secondary" data-confirm="Reverse this payment?">Cancel</button></form><% } %></td></tr><% }) %></tbody></table></details></section><% }) %>
