<section class="invoice-card hr-card hr-payslip"><h2><%= run.company %></h2><p><%= slip.employee_name %> · <%= slip.employee_id %></p><p>Payroll period <strong><%= run.period %></strong> · PAY-<%= run.id %> · <%= run.docstatus==='submitted'?'Posted payslip':run.docstatus==='draft'?'DRAFT — not posted':'CANCELLED' %></p>
<p>Shop / cost center: <%= slip.cost_center||'Unassigned' %> · Paid calendar days: <%= slip.paid_days %> / <%= slip.calendar_days %></p>
<table><thead><tr><th>Component</th><th>Type</th><th>Amount</th></tr></thead><tbody><% slip.components.filter(c=>c.kind!=='employer').forEach(c=>{ %><tr><td><%= c.label %></td><td><%= c.kind %></td><td><%= money(c.calculated_amount) %></td></tr><% }) %></tbody><tfoot><tr><th colspan="2">Gross pay</th><td><%= money(slip.gross_pay) %></td></tr><tr><th colspan="2">Deductions</th><td><%= money(slip.deductions) %></td></tr><tr><th colspan="2">Net pay</th><td><strong><%= money(slip.net_pay) %></strong></td></tr><% if(run.docstatus==='submitted'){ %><tr><th colspan="2">Paid</th><td><%= money(slip.paid_amount) %></td></tr><tr><th colspan="2">Outstanding</th><td><%= money(Number(slip.net_pay)-Number(slip.paid_amount)) %></td></tr><% } %></tfoot></table>
<p>Employer contributions: <%= money(slip.employer_cost) %> (not deducted from net pay).</p><p><%= slip.input_note %></p>
<div class="hr-actions hr-no-print"><button class="button" type="button" data-hr-print>Print / Save PDF</button><a class="button secondary" href="/hr/payslips">Back to payslips</a></div>
</section>
