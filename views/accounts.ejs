<!doctype html>
<html lang="en">
<head>
  <title>Chart of Accounts</title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">Accounting</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Home', href: '/' }, { label: 'Accounts', href: '/accounts' }, { label: 'Chart of Accounts' }] }) %>
      </div>
      <nav>
        <%- include('module-nav', { activeModule: 'accounts' }) %>
        <% if (can('accounts.manage')) { %><a class="button" href="/accounts/new" aria-label="New Account">New</a><% } %>
      </nav>
    </header>

    <form class="report-filters accounts-filters" method="get" action="/accounts" data-static-labels>
      <label><span>Search</span>
        <input type="search" name="q" value="<%= filters.q %>" placeholder="Account code or name">
      </label>
      <label><span>Root Type</span>
        <select name="root_type">
          <option value="">All root types</option>
          <% ['asset', 'liability', 'equity', 'income', 'expense'].forEach((type) => { %>
            <option value="<%= type %>" <%= filters.root_type === type ? 'selected' : '' %>><%= type.charAt(0).toUpperCase() + type.slice(1) %></option>
          <% }) %>
        </select>
      </label>
      <label><span>Account Type</span>
        <select name="detail_type">
          <option value="">All account types</option>
          <% detailTypes.forEach((type) => { %>
            <option value="<%= type %>" <%= filters.detail_type === type ? 'selected' : '' %>><%= type %></option>
          <% }) %>
        </select>
      </label>
      <label><span>Status</span>
        <select name="status">
          <option value="">All statuses</option>
          <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
          <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
        </select>
      </label>
      <label><span>Account Kind</span>
        <select name="kind">
          <option value="">All accounts</option>
          <option value="posting" <%= filters.kind === 'posting' ? 'selected' : '' %>>Posting accounts</option>
          <option value="group" <%= filters.kind === 'group' ? 'selected' : '' %>>Group accounts</option>
        </select>
      </label>
      <div class="report-filter-actions">
        <button type="submit">Apply</button>
        <a class="button button-light" href="/accounts">Reset</a>
      </div>
    </form>
    <p class="muted">Showing <%= accounts.length %> of <%= totalAccounts %> accounts.</p>

    <section class="invoice-card report-section">
      <table>
        <thead>
          <tr>
            <th class="row-number">#</th>
            <th>Code</th>
            <th>Account</th>
            <th>Root Type</th>
            <th>Account Type</th>
            <th>Normal Balance</th>
            <th>Status</th>
            <% if (can('accounts.manage')) { %><th>Action</th><% } %>
          </tr>
        </thead>
        <tbody>
          <% if (!accounts.length) { %>
            <tr><td colspan="<%= can('accounts.manage') ? 8 : 7 %>" class="empty">No accounts found.</td></tr>
          <% } %>
          <% accounts.forEach((account, index) => { %>
            <tr>
              <td class="row-number"><%= index + 1 %></td>
              <td><strong><%= account.account_code %></strong></td>
              <td><%= account.account_name %></td>
              <td><%= account.account_type %></td>
              <td><%= account.account_detail_type || '' %></td>
              <td><%= account.normal_balance %></td>
              <td><span class="badge <%= account.is_active ? 'submitted' : 'draft' %>"><%= account.is_active ? 'Active' : 'Inactive' %></span></td>
              <% if (can('accounts.manage')) { %><td><a href="/accounts/<%= account.id %>/edit">Edit</a></td><% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  </main>
</body>
</html>
