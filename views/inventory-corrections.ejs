<!doctype html><html lang="en"><head><title>Inventory corrections</title><%- include('partials-head') %></head><body><main class="shell ui-page ui-page-list ui-list-compact">
<header class="topbar"><%- include('breadcrumbs',{breadcrumbs:[{label:'Home',href:'/'},{label:'Stock Reconciliation',href:'/stock/reconciliations'},{label:'Inventory corrections'}]}) %><%- include('module-nav',{activeModule:'stock'}) %></header>
<%- include('stock-reconciliation-tabs',{activeReconciliationTab:'corrections'}) %>
<% if(error) { %><p class="error" role="alert"><%= error %></p><% } %>
<section class="ui-surface"><%- include('ui-section-heading',{heading:{title:'Current-period corrections',help:'Closed original records remain unchanged. Absorbed corrections document movements already included in a closed count and never move stock again. Physical corrections record actual new movements. All corrections require independent approval.'}}) %><p>Source document-and-line references are unique within each warehouse. For multi-item originals, prepare a separate, clearly referenced item/line correction and allocate its financial amounts without repeating the full document total. Explain the original event and attach its document/count reference in the reason. Absorbed quantity allocations cannot exceed the signed discrepancy of the selected count item.</p></section>
<% if(enabled&&can('inventory.correction.create')) { %><form action="/stock/reconciliations/corrections" method="post" class="ui-surface"><%- include('ui-section-heading',{heading:{title:'Prepare correction'}}) %><div class="ui-form-grid">
<label>Warehouse<select name="warehouse" required><% warehouses.forEach(w=>{ %><option><%= w.warehouse %></option><% }) %></select></label>
<label>Original document/source reference<input name="source_reference" required minlength="3" maxlength="200"></label><label>Treatment<select name="treatment"><option value="absorbed">Already absorbed in closed count — no stock movement</option><option value="physical">Actual new physical movement</option></select></label>
<label>Count ID (required for absorbed)<input name="count_id" type="number" min="1"></label><label>Item code<input name="item_code" required></label><label>Signed quantity (+receipt, −issue)<input name="quantity" type="number" step="0.001" required></label><label>Incoming valuation rate<input name="rate" type="number" min="0" step="1" value="0"></label><label>Reason and evidence references<textarea name="reason" required minlength="10"></textarea></label></div>
<%- include('ui-section-heading',{heading:{title:'Financial reclassification',help:'Required for an absorbed correction. Enter balanced current-period debit/credit lines reviewed against the reconciliation accounting. Inventory net change must be zero for absorbed movements. Leave empty for a physical correction to use the standard inventory adjustment accounts.'}}) %>
<div class="ui-table-scroll"><table class="editable"><thead><tr><th>Account</th><th>Debit</th><th>Credit</th><th>Party type (AR/AP)</th><th>Party ID</th></tr></thead><tbody><% for(let n=0;n<8;n++){ %><tr><td><select name="account_id" aria-label="Account <%= n+1 %>"><option value="">Choose account</option><% accounts.forEach(a=>{ %><option value="<%= a.id %>"><%= a.account_code %> — <%= a.account_name %></option><% }) %></select></td><td><input name="debit" aria-label="Debit <%= n+1 %>" type="number" min="0" step="1"></td><td><input name="credit" aria-label="Credit <%= n+1 %>" type="number" min="0" step="1"></td><td><select name="party_type" aria-label="Party type <%= n+1 %>"><option value="">None</option><option value="customer">Customer</option><option value="supplier">Supplier</option></select></td><td><input name="party_id" aria-label="Party ID <%= n+1 %>"></td></tr><% } %></tbody></table></div><div class="ui-form-footer"><button type="submit">Save for independent approval</button></div></form><% } %>
<section class="ui-surface ui-results"><%- include('ui-section-heading',{heading:{title:'Corrections',meta:'Latest 200 corrections'}}) %><div class="ui-table-scroll"><table class="ui-table"><thead><tr><th>Correction</th><th>Warehouse</th><th>Source / reason</th><th>Treatment</th><th>Item / quantity</th><th>Financial lines</th><th>Status / actions</th></tr></thead><tbody>
<% corrections.forEach(c=>{ %><tr><td>COR-<%= c.id %></td><td><%= c.warehouse %></td><td><strong><%= c.source_reference %></strong><p><%= c.reason %></p></td><td><%= c.treatment %><% if(c.count_id) { %> — <a href="/stock/reconciliations/counts/<%= c.count_id %>">COUNT-<%= c.count_id %></a><% } %></td><td><%= c.item_code %> / <%= c.quantity %></td><td><% c.financial_lines.forEach(l=>{const a=accounts.find(a=>Number(a.id)===Number(l.account_id)); %><p><%= a?`${a.account_code} ${a.account_name}`:l.account_id %>: debit <%= l.debit||0 %>, credit <%= l.credit||0 %> <%= l.party_name||l.party_id||'' %></p><% }) %><% if(!c.financial_lines.length) { %>Standard stock adjustment accounts<% } %></td><td><%= c.state %><% if(c.state==='draft'&&can('inventory.correction.approve')&&String(c.prepared_by)!==String(currentUser.id)) { %><form method="post" action="/stock/reconciliations/corrections/<%= c.id %>/approve"><button type="submit" class="button-light">Approve</button></form><% } %><% if(c.state==='approved'&&can('inventory.correction.submit')) { %><form method="post" action="/stock/reconciliations/corrections/<%= c.id %>/submit"><button type="submit">Post current-period correction</button></form><% } %><% if(['draft','approved'].includes(c.state)&&can('inventory.correction.abandon')) { %><form method="post" action="/stock/reconciliations/corrections/<%= c.id %>/abandon"><label>Abandonment reason<input name="reason" minlength="10" required></label><button type="submit" class="button-light">Abandon unposted correction</button></form><% } %><%= c.abandon_reason||'' %> <%= stamp(c.submitted_at) %></td></tr><% }) %>
<% if(!corrections.length) { %><tr><td colspan="7" class="empty">No corrections.</td></tr><% } %></tbody></table></div></section>
</main></body></html>
