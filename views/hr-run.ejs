<section class="invoice-card hr-card"><h2>PAY-<%= run.id %> · <%= run.company %></h2><p>Period: <%= run.period %> · Posting: <%= formatDate(run.posting_date) %> · <span class="badge <%= run.docstatus %>"><%= run.docstatus %></span></p>
<p>Prepared by <%= run.created_by||'Unknown' %><% if(run.submitted_at){ %> · Posted <%= formatTimestamp(run.submitted_at) %><% } %></p>
<div class="hr-actions hr-no-print"><a class="button secondary" href="/hr/payroll/<%= run.id %>/export">Export payroll CSV</a>
<% if(run.docstatus==='draft'&&can('hr.payroll.submit')){ %><form method="post" action="/hr/payroll/<%= run.id %>/submit"><button class="button" data-confirm="Approve and post this payroll to the general ledger?">Approve and post</button></form><% } %>
<% if(run.docstatus!=='cancelled'&&can('hr.payroll.cancel')){ %><details><summary>Cancel payroll</summary><form method="post" action="/hr/payroll/<%= run.id %>/cancel" class="hr-grid"><label>Cancellation date<input type="date" name="posting_date" value="<%= today %>" required></label><label>Reason<input name="reason" required maxlength="2000"></label><button class="button secondary" data-confirm="Cancel this payroll and reverse its accounting entries?">Cancel payroll</button></form></details><% } %>
</div><% if(run.cancellation_reason){ %><p>Cancellation: <%= run.cancellation_reason %></p><% } %>
<div class="table-wrap"><table><thead><tr><th>Employee</th><th>Paid days</th><th>Gross</th><th>Deductions</th><th>Net</th><th>Employer contribution</th><th>Paid</th><th>Outstanding</th><th>Payment status</th></tr></thead><tbody><% slips.forEach(s=>{ %><tr><td><a href="/hr/payroll/<%= run.id %>/payslips/<%= s.id %>"><%= s.employee_name %></a></td><td><%= s.paid_days %> / <%= s.calendar_days %></td><td><%= money(s.gross_pay) %></td><td><%= money(s.deductions) %></td><td><%= money(s.net_pay) %></td><td><%= money(s.employer_cost) %></td><td><%= money(s.paid_amount) %></td><td><%= run.docstatus==='submitted'?money(Number(s.net_pay)-Number(s.paid_amount)):'—' %></td><td><%= run.docstatus!=='submitted'?'—':Number(s.net_pay)===Number(s.paid_amount)?'Paid':Number(s.paid_amount)>0?'Partly paid':'Unpaid' %></td></tr><% }) %></tbody></table></div>
</section>
<% slips.forEach(s=>{ %>
<section class="invoice-card hr-card hr-no-print"><details <%= run.docstatus==='draft'?'open':'' %>><summary><%= s.employee_name %> · <%= s.cost_center||'Unassigned shop' %></summary>
<% if(run.docstatus==='draft'&&can('hr.payroll.edit')){ %>
<form method="post" action="/hr/payroll/<%= run.id %>/slips/<%= s.id %>" class="hr-stack">
<label>Paid calendar days<input type="number" name="paid_days" value="<%= s.paid_days %>" min="0" max="<%= s.calendar_days %>" step="0.5" required></label>
<p>Payroll uses approved manual inputs. Check attendance and leave separately; missing attendance is not deducted automatically. Adjust variable earnings such as commission here.</p>
<%- include('hr-components',{items:s.components}) %>
<% const employeeBalances=balances.filter(m=>m.employee_id===s.employee_id&&m.docstatus==='submitted'&&m.kind!=='reimbursement'&&m.balance>0); %>
<% if(can('hr.money.view')){ %><h3>Recover employee balances</h3><div class="table-wrap"><table><thead><tr><th>Balance to recover</th><th>Amount (UGX)</th></tr></thead><tbody>
<% const savedRecoveries=recoveries.filter(r=>String(r.slip_id)===String(s.id)); for(let index=0;index<Math.max(3,savedRecoveries.length);index++){const saved=savedRecoveries[index]; %><tr><td><select name="recoveries[<%= index %>][money_id]"><option value="">No recovery</option><% employeeBalances.forEach(m=>{ %><option value="<%= m.id %>" <%= saved&&String(saved.money_id)===String(m.id)?'selected':'' %>>HRM-<%= m.id %> · <%= m.kind %> · <%= m.reason %> · <%= money(m.balance) %> available</option><% }) %></select></td><td><input type="number" name="recoveries[<%= index %>][amount]" min="0" step="0.01" value="<%= saved?saved.amount:0 %>"></td></tr><% } %>
</tbody></table></div><% } %>
<label>Review note<textarea name="input_note" required maxlength="2000" placeholder="Explain paid days, commission inputs and recovery amounts."><%= s.input_note||'' %></textarea></label><button class="button">Save reviewed inputs</button></form>
<% }else{ %><p><%= s.input_note||'Inputs awaiting review.' %></p><% } %>
<% if(run.docstatus==='submitted'&&can('hr.payroll.pay')&&Number(s.net_pay)>Number(s.paid_amount)){ %><h3>Record salary payment</h3><%- include('hr-payment-form',{action:`/hr/payroll/${run.id}/pay`,slipId:s.id,maximum:Number(s.net_pay)-Number(s.paid_amount),buttonLabel:'Record payment'}) %><% } %>
</details></section><% }) %>
<section class="invoice-card hr-card"><h2>Payment history</h2><table><thead><tr><th>Employee</th><th>Date</th><th>Amount</th><th>Account</th><th>Reference</th><th>Status</th><th class="hr-no-print">Action</th></tr></thead><tbody><% payments.forEach(p=>{ %><tr><td><%= p.employee_name %></td><td><%= formatDate(p.posting_date) %></td><td><%= money(p.amount) %></td><td><%= p.account_name %></td><td><%= p.reference %></td><td><%= p.docstatus %></td><td class="hr-no-print"><% if(p.docstatus==='submitted'&&can('hr.payroll.cancel')){ %><form method="post" action="/hr/payroll/<%= run.id %>/cancel-payment" class="hr-inline"><input type="hidden" name="payment_id" value="<%= p.id %>"><label>Reversal date<input type="date" name="posting_date" value="<%= today %>" required></label><button class="button secondary" data-confirm="Reverse this salary payment?">Cancel payment</button></form><% } %></td></tr><% }) %></tbody></table></section>
