<% const voucherTitle = invoice.is_cash_sale ? 'Cash Sales Invoice' : 'Sales Invoice'; %>
<!doctype html>
<html lang="en">
<head>
  <title><%= voucherTitle %> <%= invoice.invoice_no %></title>
  <%- include('partials-head') %>
</head>
<body class="print-page">
  <main class="print-sheet">
    <div class="print-actions no-print">
      <button onclick="window.print()">Print</button>
    </div>
    <%- include('invoice-header', { voucherTitle }) %>
    <section class="invoice-meta">
      <div>
        <span>Bill To</span>
        <strong><%= invoice.customer_name %></strong>
        <% if (invoice.customer_phone) { %><p><%= invoice.customer_phone %></p><% } %>
      </div>
      <div>
        <span>Invoice Date</span>
        <strong><%= invoice.invoice_date %></strong>
        <% if (invoice.due_date) { %><p>Due <%= invoice.due_date %></p><% } %>
      </div>
      <div>
        <span>Payment Status</span>
        <strong><%- include('invoice-payment-status', { invoice, money }) -%></strong>
      </div>
    </section>

    <table class="print-invoice-table print-items-table">
      <colgroup>
        <col class="print-number-column">
        <col class="print-name-column">
        <col class="print-quantity-column">
        <col class="print-money-column">
        <col class="print-money-column">
      </colgroup>
      <thead>
        <tr>
          <th class="row-number">#</th>
          <th class="item-code-col">Item Name</th>
          <th>Qty</th>
          <th>Unit Price</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach((item, index) => { %>
          <tr>
            <td class="row-number"><%= index + 1 %></td>
            <td class="item-code-col"><%= item.item_name || item.item_code %></td>
            <td><%= Number(item.quantity).toLocaleString() %></td>
            <td><%= money(item.unit_price) %></td>
            <td><%= money(item.line_total) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <th colspan="4">Subtotal</th>
          <td><%= money(invoice.subtotal) %></td>
        </tr>
        <tr>
          <th colspan="4">Discount</th>
          <td><%= money(invoice.discount_amount) %></td>
        </tr>
        <tr>
          <th colspan="4">Tax</th>
          <td><%= money(invoice.tax_amount) %></td>
        </tr>
        <tr class="grand">
          <th colspan="4">Total</th>
          <td><%= money(invoice.total) %></td>
        </tr>
        <tr>
          <th colspan="4">Paid</th>
          <td><%= money(invoice.amount_paid) %></td>
        </tr>
        <tr>
          <th colspan="4">Balance</th>
          <td><%= money(invoice.total - invoice.amount_paid) %></td>
        </tr>
      </tfoot>
    </table>

    <% if (invoice.notes) { %>
      <p class="notes"><%= invoice.notes %></p>
    <% } %>

    <% const payments = Array.isArray(invoice.payments) ? invoice.payments : []; %>
    <% if (payments.length) { %>
      <section class="print-payments">
        <h2>Payments</h2>
        <table class="print-invoice-table">
          <thead>
            <tr>
              <th class="row-number">#</th>
              <th>Date</th>
              <th>Method</th>
              <th>Payment Reference</th>
              <th>Amount</th>
            </tr>
          </thead>
          <tbody>
            <% payments.forEach((payment, index) => { %>
              <tr>
                <td class="row-number"><%= index + 1 %></td>
                <td><%= payment.payment_date %></td>
                <td><%= payment.method %></td>
                <td><%= payment.reference || '' %></td>
                <td><%= money(payment.amount) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    <% } %>
  </main>
</body>
</html>
