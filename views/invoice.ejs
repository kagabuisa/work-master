<% const voucherTitle = invoice.is_cash_sale ? 'Cash Sales Invoice' : 'Sales Invoice'; %>
<!doctype html>
<html lang="en">
<head>
  <title><%= voucherTitle %> <%= invoice.invoice_no %></title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Dashboard', href: '/' }, { label: 'Invoices', href: '/invoices' }, { label: invoice.invoice_no }] }) %>
      </div>
      <nav>
        <%- include('module-nav', { activeModule: 'sales' }) %>
        <%- include('invoice-actions', { invoice }) %>
      </nav>
    </header>
    <% if (error) { %><section class="notice warning"><strong><%= error %></strong></section><% } %>
    <%- include('invoice-detail', { invoice, items, today, money }) %>
  </main>
</body>
</html>
