<% const voucherTitle = invoice.is_cash_sale ? 'Cash Sales Invoice' : 'Sales Invoice'; %>
<!doctype html>
<html lang="en">
<head>
  <title><%= voucherTitle %> <%= invoice.invoice_no %></title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell ui-page ui-page-form">
    <header class="topbar">
      <div>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Home', href: '/' }, { label: 'Sales', href: '/invoices' }, { label: 'Sales Invoices', href: '/invoices' }, { label: invoice.invoice_no }] }) %>
      </div>
      <nav>
        <%- include('module-nav', { activeModule: 'sales' }) %>
        <%- include('invoice-actions', { invoice,
          sharedAccessOnly: typeof sharedAccessOnly !== 'undefined' ? sharedAccessOnly : false,
          sharedWriteAccess: typeof sharedWriteAccess !== 'undefined' ? sharedWriteAccess : false }) %>
      </nav>
    </header>
    <% if (error) { %><section class="notice warning"><strong><%= error %></strong></section><% } %>
    <%- include('invoice-detail', { invoice, items, today, money,
      sharedAccessOnly: typeof sharedAccessOnly !== 'undefined' ? sharedAccessOnly : false }) %>
    <%- include('invoice-approval',{invoice,
      sharedAccessOnly: typeof sharedAccessOnly !== 'undefined' ? sharedAccessOnly : false}) %>
    <%- include('voucher-sharing', { sharing: typeof sharing !== 'undefined' ? sharing : null }) %>
    <%- include('record-audit', { record: invoice }) %>
  </main>
</body>
</html>
