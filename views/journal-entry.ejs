<!doctype html>
<% const journalReadOnly = Boolean(readOnly); %>
<% const journalLines = Array.isArray(journal.lines) && journal.lines.length ? journal.lines : [{}, {}]; %>
<% const journalStatus = journal.docstatus || (journalReadOnly ? 'submitted' : 'draft'); %>
<% const manualJournal = Boolean(journal.can_cancel); %>
<% const lineAuditTime = (value) => value ? `${formatTimestamp(value, 'UTC')} UTC` : ''; %>
<html lang="en">
<head>
  <title><%= journal.id ? journal.journal_no : 'New Journal' %></title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">Accounting</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Home', href: '/' }, { label: 'Accounts', href: '/accounts' }, { label: 'Journals', href: '/journals' }, { label: journal.id ? journal.journal_no : 'New Journal Entry' }] }) %>
      </div>
      <nav>
        <%- include('module-nav', { activeModule: 'accounts' }) %><%- include('journal-new-button') %>
      </nav>
    </header>

    <% if (error) { %>
      <section class="notice warning"><strong><%= error %></strong></section>
    <% } %>

    <form method="post" action="<%= journal.id ? `/journals/${journal.id}` : '/journals' %>" class="invoice-form" id="journal-entry-form" <%= journalReadOnly ? '' : 'data-voucher-form' %>>
      <section class="form-grid">
        <label>
          Type
          <select name="journal_type" id="journal-type" required <%= journalReadOnly ? 'disabled' : '' %>>
            <option value="cash_receipt" <%= journal.journal_type === 'cash_receipt' ? 'selected' : '' %>>Cash Receipt</option>
            <option value="payment_journal" <%= journal.journal_type === 'payment_journal' ? 'selected' : '' %>>Payment Journal</option>
            <option value="journal_entry" <%= journal.journal_type === 'journal_entry' ? 'selected' : '' %>>Journal Entry</option>
            <option value="sales_invoice" <%= journal.journal_type === 'sales_invoice' ? 'selected' : '' %>>Sales Invoice</option>
          </select>
        </label>
        <div class="journal-posting-date">
          <label>
            Posting Date
            <input type="date" name="posting_date" value="<%= journal.posting_date || today %>" required <%= journalReadOnly ? 'readonly' : '' %>>
          </label>
          <details class="journal-posting-time" <%= journal.posting_time === '' ? 'open' : '' %>>
            <summary><%= journalReadOnly ? 'View time' : 'Edit time' %></summary>
            <label>
              Posting Time
              <input type="time" name="posting_time" value="<%= journal.posting_time !== undefined ? journal.posting_time : currentPostingTime() %>" required <%= journalReadOnly ? 'readonly' : '' %>>
            </label>
          </details>
        </div>
        <%- include('cost-center-field', { value: journal.cost_center, readOnly: journalReadOnly }) %>
        <label>
          Party Type
          <select name="party_type" id="party-type" <%= journalReadOnly ? 'disabled' : '' %>>
            <option value="" <%= !journal.party_type ? 'selected' : '' %>>None</option>
            <option value="customer" <%= journal.party_type === 'customer' ? 'selected' : '' %>>Customer</option>
            <option value="supplier" <%= journal.party_type === 'supplier' ? 'selected' : '' %>>Supplier</option>
            <option value="employee" <%= journal.party_type === 'employee' ? 'selected' : '' %>>Employee</option>
          </select>
        </label>
        <% if (journalReadOnly) { %>
          <label>
            Party ID
            <input name="party_id" value="<%= journal.party_id || '' %>" readonly>
          </label>
        <% } else { %>
          <label class="lookup-field">
            Party ID
            <input id="party-search" autocomplete="off" placeholder="Choose a party type first" value="<%= journal.party_id || '' %>">
            <input type="hidden" name="party_id" id="party-id" value="<%= journal.party_id || '' %>">
            <div id="party-results" class="results"></div>
          </label>
        <% } %>
        <input type="hidden" name="party_name" id="party-name" value="<%= journal.party_name || '' %>">
        <% if (journalReadOnly) { %>
          <label>
            Reference
            <input name="reference_no" value="<%= journal.reference_no || '' %>" readonly>
          </label>
        <% } else { %>
          <label class="lookup-field">
            References
            <input id="reference-search" autocomplete="off" placeholder="Select a party first" value="<%= journal.reference_no || '' %>">
            <input type="hidden" name="reference_no" id="journal-header-reference" value="<%= journal.reference_no || '' %>">
            <div id="reference-results" class="results"></div>
            <span class="field-hint">Select multiple references to add their party account rows. Edit amounts for partial payments.</span>
            <div id="journal-selected-references" class="journal-reference-chips" aria-label="Selected references"></div>
          </label>
        <% } %>
      </section>

      <section id="journal-selection-summary" class="journal-selection-summary" aria-label="Selected party and reference" <%= journal.party_name || journalReadOnly && journal.reference_no ? '' : 'hidden' %>>
        <div id="party-selection-detail" class="journal-selection-detail" data-detail-title="Selected party" role="status" <%= journal.party_name ? '' : 'hidden' %>><%= journal.party_name || '' %></div>
        <% if (journalReadOnly) { %>
          <% if (journal.reference_no) { const detail = typeof selectedReference !== 'undefined' ? selectedReference : null; %>
            <div class="journal-selection-detail" data-detail-title="Selected reference">
              <% if (detail) { %>
                <%= [detail.type, detail.posting_date].filter(Boolean).join(' · ') %>
                <% if (detail.amount != null) { %> · Amount <%= money(detail.amount) %><% } %>
                <% if (detail.balance != null) { %> · Balance <%= money(detail.balance) %><% } %>
              <% } else { %><%= journal.reference_no %><% } %>
            </div>
          <% } %>
        <% } else { %>
          <div id="reference-selection-detail" class="journal-selection-detail" data-detail-title="Selected reference" role="status" hidden></div>
        <% } %>
      </section>

      <% if (!journalReadOnly) { %>
        <script id="journal-account-data" type="application/json"><%- scriptJson(accounts.map((account) => ({ id: String(account.id), code: account.account_code, name: account.account_name }))) %></script>
      <% } %>
      <p class="field-hint">Select References above to add party account rows. Supplier invoices use Accounts Payable debits; customer invoices use Accounts Receivable credits. Adjust amounts for partial payments and add the balancing bank or cash row with no reference.</p>
      <datalist id="journal-purchase-invoices"></datalist>
      <table class="editable" id="journal-lines">
        <thead>
          <tr>
            <th class="row-number">#</th>
            <th>Account</th>
            <th>Debit</th>
            <th>Credit</th>
            <th>Reference</th>
            <th>Line Remarks</th>
            <th>Status</th>
            <% if (journalReadOnly) { %><th class="tracking-info">Created by</th><th class="tracking-info">Updated by</th><% } %>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% journalLines.forEach((line, index) => { %>
            <tr>
              <td class="row-number"><%= index + 1 %></td>
              <td>
                <input type="hidden" name="line_id" value="<%= line.id || '' %>">
                <% if (journalReadOnly) { %>
                  <span><%= line.account_code || accounts.find((account) => Number(account.id) === Number(line.account_id))?.account_code || '' %> - <%= line.account_name || accounts.find((account) => Number(account.id) === Number(line.account_id))?.account_name || '' %></span>
                <% } else { const selectedAccount = accounts.find((account) => Number(account.id) === Number(line.account_id)); %>
                  <div class="journal-account-picker">
                    <input type="hidden" name="account_id" value="<%= selectedAccount ? selectedAccount.id : '' %>">
                    <input type="text" data-account-search autocomplete="off" role="combobox" aria-label="Account" aria-autocomplete="list" aria-controls="journal-account-menu" aria-expanded="false" placeholder="Search code or name (% wildcard)" value="<%= selectedAccount ? `${selectedAccount.account_code} - ${selectedAccount.account_name}` : '' %>">
                  </div>
                <% } %>
              </td>
              <td><input class="journal-money" name="debit" type="number" step="1" min="0" value="<%= line.debit || '' %>" <%= journalReadOnly ? 'readonly' : '' %>></td>
              <td><input class="journal-money" name="credit" type="number" step="1" min="0" value="<%= line.credit || '' %>" <%= journalReadOnly ? 'readonly' : '' %>></td>
              <td>
                <% if (journalReadOnly) { %><%= line.reference_no || '' %><% } else { %>
                  <input name="line_reference_no" value="<%= line.reference_no || '' %>" list="journal-purchase-invoices" autocomplete="off" aria-label="Invoice reference" placeholder="Select party invoice">
                <% } %>
              </td>
              <td><input name="line_remarks" value="<%= line.remarks || '' %>" <%= journalReadOnly ? 'readonly' : '' %>></td>
              <td><span class="badge <%= journalStatus %>"><%= journalStatus === 'draft' ? 'Draft' : journalStatus === 'cancelled' ? 'Cancelled' : 'Submitted' %></span></td>
              <% if (journalReadOnly) { %><td class="tracking-info"><%= line.created_by || 'Unknown' %><% if (lineAuditTime(line.created_at)) { %> <small><%= lineAuditTime(line.created_at) %></small><% } %></td><td class="tracking-info"><%= line.updated_by || 'Unknown' %><% if (lineAuditTime(line.updated_at)) { %> <small><%= lineAuditTime(line.updated_at) %></small><% } %></td><% } %>
              <td><button type="button" class="button-light" data-remove-journal-row <%= journalReadOnly ? 'hidden' : '' %>>Remove</button></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <th colspan="2">Total</th>
            <th id="journal-total-debit"><%= money(journal.total_debit || 0) %></th>
            <th id="journal-total-credit"><%= money(journal.total_credit || 0) %></th>
            <th id="journal-balance-status" colspan="4"></th>
          </tr>
        </tfoot>
      </table>

      <section class="form-grid">
        <label class="wide">
          Remarks
          <input name="remarks" value="<%= journal.remarks || '' %>" <%= journalReadOnly ? 'readonly' : '' %>>
        </label>
      </section>

      <div class="actions">
        <% if (!journalReadOnly) { %>
          <button type="button" class="button-light" id="add-journal-row">Add Row</button>
          <button type="submit" name="action" value="save_draft" data-voucher-save>Save Draft</button>
          <% if (!journal.id && can('vouchers.journals.submit')) { %><button type="submit" name="action" value="submit">Post Journal</button><% } %>
        <% } %>
        <% if (journalReadOnly) { %>
          <% if (journalStatus === 'draft' && can('vouchers.journals.edit')) { %><a class="button" href="/journals/<%= journal.id %>/edit">Edit Draft</a><% } %>
          <% if (journalStatus === 'draft' && can('vouchers.journals.submit')) { %><button type="submit" formaction="/journals/<%= journal.id %>/submit" formmethod="post">Submit Journal</button><% } %>
          <% if (journalStatus === 'draft' && can('vouchers.journals.delete')) { %><button type="submit" formaction="/journals/<%= journal.id %>/delete" formmethod="post" class="button-light" data-confirm="Delete this draft journal? This cannot be undone.">Delete Draft</button><% } %>
          <% if (journalStatus === 'cancelled' && currentUser.role === 'admin') { %><button type="submit" formaction="/journals/<%= journal.id %>/delete" formmethod="post" class="button-light" data-confirm="Delete this cancelled journal? Its ledger reversal history will remain. This cannot be undone.">Delete Voucher</button><% } %>
          <% if (journalStatus !== 'draft' && can('reports.general-ledger.view')) { %><a class="button" href="/reports/general-ledger?voucher_type=<%= journal.journal_type %>&q=<%= encodeURIComponent(journal.journal_no || '') %>">View GL</a><% } %>
          <% if (manualJournal && journalStatus === 'submitted' && can('vouchers.journals.cancel')) { %>
            <button type="submit" formaction="/journals/<%= journal.id %>/cancel" formmethod="post" class="button-light" data-confirm="Cancel this journal? This will reverse its ledger entries.">Cancel Journal</button>
          <% } else if (!manualJournal) { %>
            <span class="field-hint">Automatically generated journals are cancelled from their source document.</span>
          <% } %>
        <% } %>
      </div>
    </form>
    <% if (journal && journal.id) { %><%- include('record-audit', { record: journal }) %><% } %>
  </main>
  <% if (!journalReadOnly) { %>
    <script src="/journal-account-match.js?v=<%= assetVersion %>"></script>
    <script src="/journal-entry.js?v=<%= assetVersion %>"></script>
    <script src="/cost-center-field.js?v=<%= assetVersion %>"></script>
  <% } %>
</body>
</html>
