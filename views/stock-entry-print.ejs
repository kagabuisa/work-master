<% const entryStatus = entry.docstatus || 'submitted'; %>
<% const statusLabel = entryStatus === 'draft' ? 'Draft' : entryStatus === 'cancelled' ? 'Cancelled' : 'Submitted'; %>
<% const isReconciliation = entry.entry_type === 'reconciliation'; %>
<% const warehouses = [...new Set((items || []).map((item) => item.warehouse).filter(Boolean))]; %>
<% const itemValue = (item) => Math.round(Number(item.quantity || 0) * Number(item.valuation_rate || 0)); %>
<% const itemColumns = isReconciliation ? (entryStatus === 'draft' ? 6 : 7) : 7; %>
<% const deliveryDetails = entry.delivery_details || {}; %>
<!doctype html>
<html lang="en">
<head>
  <title><%= isReconciliation ? 'Stock Reconciliation' : 'Stock Entry' %> <%= entry.entry_no %></title>
  <%- include('partials-head') %>
</head>
<body class="print-page">
  <main class="print-sheet">
    <div class="print-actions no-print">
      <button type="button" data-print-page>Print</button>
    </div>
    <header class="invoice-document-header">
      <div class="invoice-header-company"><%- include('invoice-company') %></div>
      <div class="invoice-voucher-info">
        <h1><%= isReconciliation ? 'Stock Reconciliation' : 'Stock Entry' %></h1>
        <p><%= entry.entry_no %></p>
      </div>
    </header>
    <section class="invoice-meta">
      <div><span>Type</span><strong><%= stockEntryTypeLabels[entry.entry_type] || entry.entry_type %></strong></div>
      <% if (entry.source_stock_entry_no) { %><div><span>Originating stock entry</span><strong><%= entry.source_stock_entry_no %></strong></div><% } %>
      <div><span>Posting Date/Time</span><strong><%= formatDateTime(entry.posting_date, entry.posting_time || '00:00') %></strong></div>
      <div><span>Status</span><strong><%= statusLabel %></strong></div>
    </section>
    <section class="invoice-meta">
      <div><span>Warehouse</span><strong><%= warehouses.length ? warehouses.join(', ') : '—' %></strong></div>
      <% if (entry.cost_center) { %><div><span>Cost Center</span><strong><%= costCenterName(entry.cost_center) %></strong></div><% } %>
      <% if (!isReconciliation) { %><div><span>Delivery status</span><strong><%= entry.delivery_status || 'Not set' %></strong></div><% } %>
    </section>
    <% if (!isReconciliation && (deliveryDetails.picked_employee_name || deliveryDetails.picked_date
      || deliveryDetails.in_transit_date || deliveryDetails.transporter_name || deliveryDetails.delivered_date
      || deliveryDetails.received_by_employee_name || deliveryDetails.received_date)) { %>
      <section class="invoice-meta">
        <% if (deliveryDetails.picked_employee_name || deliveryDetails.picked_date) { %><div><span>Picked &amp; packed</span><strong><%= [deliveryDetails.picked_employee_name, deliveryDetails.picked_date ? formatDate(deliveryDetails.picked_date) : ''].filter(Boolean).join(' · ') %></strong></div><% } %>
        <% if (deliveryDetails.in_transit_date) { %><div><span>In Transit</span><strong><%= formatDate(deliveryDetails.in_transit_date) %></strong></div><% } %>
        <% if (deliveryDetails.transporter_name || deliveryDetails.delivered_date) { %><div><span>Delivered</span><strong><%= [deliveryDetails.transporter_name, deliveryDetails.transporter_phone, deliveryDetails.delivered_date ? formatDate(deliveryDetails.delivered_date) : ''].filter(Boolean).join(' · ') %></strong></div><% } %>
        <% if (deliveryDetails.received_by_employee_name || deliveryDetails.received_date) { %><div><span>Received &amp; Confirmed By</span><strong><%= [deliveryDetails.received_by_employee_name, deliveryDetails.received_date ? formatDate(deliveryDetails.received_date) : ''].filter(Boolean).join(' · ') %></strong></div><% } %>
      </section>
    <% } %>
    <% if (entry.entry_type === 'purchase' && (entry.supplier_name || entry.supplier_reference)) { %>
      <p class="notes">
        <% if (entry.supplier_name) { %>Supplier: <strong><%= entry.supplier_name %></strong><% } %>
        <% if (entry.supplier_reference) { %> · Reference: <strong><%= entry.supplier_reference %></strong><% } %>
      </p>
    <% } %>
    <table class="print-invoice-table print-items-table">
      <thead>
        <tr>
          <th class="row-number">#</th>
          <th>Item Code</th>
          <th>Source Whs</th>
          <% if (!isReconciliation) { %><th>Target Whs</th><% } %>
          <th><%= isReconciliation ? 'Counted Qty' : 'Qty' %></th>
          <% if (isReconciliation && entryStatus !== 'draft') { %><th>Change</th><% } %>
          <th>Rate</th>
          <th>Item Value</th>
        </tr>
      </thead>
      <tbody>
        <% (items || []).forEach((item, index) => { %>
          <tr>
            <td class="row-number"><%= index + 1 %></td>
            <td><%= item.item_code %></td>
            <td><%= item.warehouse || '' %></td>
            <% if (!isReconciliation) { %><td><%= item.target_warehouse || '' %></td><% } %>
            <td><%= Number(item.quantity || 0).toLocaleString() %></td>
            <% if (isReconciliation && entryStatus !== 'draft') { %><td><%= Number(item.quantity_change || 0).toLocaleString() %></td><% } %>
            <td><%= money(item.valuation_rate || 0) %></td>
            <td><%= money(itemValue(item)) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr class="grand">
          <th colspan="<%= itemColumns - 1 %>">Total item value</th>
          <td><%= money((items || []).reduce((sum, item) => sum + itemValue(item), 0)) %></td>
        </tr>
      </tfoot>
    </table>
    <% if (entry.remarks) { %><p class="notes"><%= entry.remarks %></p><% } %>
  </main>
</body>
</html>
