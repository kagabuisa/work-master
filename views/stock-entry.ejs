<!doctype html>
<% const stockEntryReadOnly = Boolean(typeof readOnly !== 'undefined' && readOnly); %>
<% const editingStockEntry = Boolean(entry && entry.id); %>
<% const selectedEntryType = entry ? entry.entry_type : (typeof defaultEntryType !== 'undefined' ? defaultEntryType : 'opening'); %>
<% const lineAuditTime = (value) => value ? `${formatTimestamp(value, 'UTC')} UTC` : ''; %>
<html lang="en">
<head>
  <title><%= selectedEntryType === 'reconciliation' ? 'Stock Reconciliation' : stockEntryReadOnly && entry ? 'Stock Entry' : editingStockEntry ? 'Edit Stock Entry' : 'New Stock Entry' %></title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell ui-page ui-page-form">
    <header class="topbar">
      <div>
        <p class="eyebrow">Inventory</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Home', href: '/' }, { label: 'Stocks', href: '/stock/entries' }, { label: 'Stock Entries', href: '/stock/entries' }, { label: stockEntryReadOnly && entry ? entry.entry_no : editingStockEntry ? 'Edit Stock Entry' : 'New Stock Entry' }] }) %>
      </div>
      <nav>
        <%- include('module-nav', { activeModule: entry && entry.entry_type === 'purchase' ? 'purchases' : 'stock' }) %>
        <% if (stockEntryReadOnly && entry) { %><%- include('stock-entry-actions', { entry }) %><% } %>
        <%- include('stock-new-menu') %>
        <% if (!stockEntryReadOnly) { %>
          <div class="actions page-actions">
            <button type="submit" form="stock-entry-form" class="button-light" name="action" value="save_draft" data-voucher-save>Save Stock Entry</button>
            <% if (can('vouchers.stock.submit') && !(typeof sharedWriteAccess !== 'undefined' && sharedWriteAccess)) { %><button type="submit" form="stock-entry-form" name="action" value="submit">Submit</button><% } %>
          </div>
        <% } %>
      </nav>
    </header>
    <% if (error) { %>
      <section class="notice warning"><strong><%= error %></strong></section>
    <% } %>
    <% if (typeof duplicateOf !== 'undefined' && duplicateOf) { %><section class="notice" role="status">Copy of <strong><%= duplicateOf %></strong>. Review the details, then save this as a new draft.</section><% } %>
    <% if (stockEntryReadOnly && entry) { %>
      <%- include('stock-entry-detail', { entry, items, money }) %>
    <% } else { %>

    <form method="post" action="<%= editingStockEntry ? `/stock/entries/${entry.id}` : '/stock/entries' %>" class="invoice-form ui-surface" id="stock-entry-form" data-prevent-enter-submit <%= stockEntryReadOnly ? '' : 'data-voucher-form' %>>
      <datalist id="stock-warehouses"></datalist>
      <%- include('ui-section-heading', { heading: { title: 'Entry details', meta: entry && entry.entry_no || '', help: 'Save keeps a draft. Submit posts the stock movement. Item details can only be edited in drafts. The owner, an admin, or a user with Read & write sharing can update delivery status after submission.' } }) %>
      <section class="form-grid ui-form-grid">
        <label>
          Type
          <select name="entry_type" id="entry-type" required>
            <% const entryChoices = [...stockEntryChoices]; if (entry && !entryChoices.includes(selectedEntryType)) entryChoices.push(selectedEntryType); %>
            <% entryChoices.forEach(type => { %><option value="<%= type %>" <%= selectedEntryType === type ? 'selected' : '' %>><%= stockEntryTypeLabels[type] || type %></option><% }) %>
          </select>
        </label>
        <% if (selectedEntryType !== 'reconciliation') { %>
          <%- include('stock-entry-delivery-field', { deliveryField: {
            value: typeof attemptedDeliveryStatus !== 'undefined' ? attemptedDeliveryStatus : entry && entry.delivery_status || '',
            disabled: Boolean(editingStockEntry && !(typeof sharedWriteAccess !== 'undefined' && sharedWriteAccess) && currentUser.role !== 'admin' && (!currentUser.id || String(currentUser.id) !== String(entry.created_by_user_id))),
          } }) %>
        <% } %>
        <label id="cancel-entry-source-wrapper" hidden>
          Entry to Cancel
          <input id="cancel-entry-source" name="cancel_entry_source" autocomplete="off" placeholder="STK-000001">
          <div class="results stock-entry-source-results"></div>
          <span class="field-hint" id="cancel-entry-source-status"></span>
        </label>
        <%- include('voucher-posting-fields', { postingFields: { date: entry ? entry.posting_date : today, time: entry && entry.posting_time ? entry.posting_time : typeof postingTime !== 'undefined' ? postingTime : currentPostingTime(), readOnly: stockEntryReadOnly, wrapperId: 'stock-entry-posting-wrapper' } }) %>
        <%- include('cost-center-field', { value: typeof attemptedCostCenter !== 'undefined' ? attemptedCostCenter : entry && entry.cost_center, readOnly: stockEntryReadOnly }) %>
        <label id="stock-entry-remarks-wrapper">
          <span>Remarks</span>
          <input name="remarks" value="<%= entry ? entry.remarks || '' : '' %>" placeholder="Optional">
        </label>
        <label class="lookup-field" id="stock-entry-item-picker">
          Items
          <input id="stock-entry-item-search" aria-label="Items" autocomplete="off" placeholder="Search and select item to add" aria-controls="stock-entry-item-results" aria-describedby="stock-entry-item-status">
          <div id="stock-entry-item-results" class="results"></div>
        </label>
      </section>
      <p id="stock-entry-item-status" class="field-hint" role="status" aria-live="polite"></p>
      <button type="button" class="inline-link" id="adjust-supplier-info" hidden>Adjust supplier info</button>
      <input type="hidden" name="supplier_name" id="supplier-name" value="<%= entry ? entry.supplier_name || '' : '' %>">
      <input type="hidden" name="supplier_contact" id="supplier-contact" value="<%= entry ? entry.supplier_contact || '' : '' %>">
      <input type="hidden" name="supplier_phone" id="supplier-phone" value="<%= entry ? entry.supplier_phone || '' : '' %>">
      <input type="hidden" name="supplier_reference" id="supplier-reference" value="<%= entry ? entry.supplier_reference || '' : '' %>">

      <p id="stock-reconciliation-hint" class="field-hint" <%= selectedEntryType === 'reconciliation' ? '' : 'hidden' %>>Enter the physical count for each item and warehouse. Submitting adjusts stock from its current balance to the count.</p>

      <%- include('ui-section-heading', { heading: { title: 'Items', help: 'Select items and warehouses, then enter quantities and rates. Transfers also require a target warehouse. Warehouse quantities show stock at the selected posting date and time. A lower available quantity protects later transactions. Quantities refresh when items, warehouses, quantities or posting date/time change, and when you return to this window.' } }) %>
      <div class="ui-table-scroll" role="region" aria-label="Stock Entry table" tabindex="0"><table class="editable" id="stock-entry-items">
        <thead>
          <tr>
            <th class="row-number">#</th>
            <th class="item-code-col">Item Code</th>
            <th class="warehouse-col">Warehouse</th>
            <th class="warehouse-col">Target Warehouse</th>
            <th id="stock-entry-quantity-heading"><%= selectedEntryType === 'reconciliation' ? 'Counted Qty' : 'Qty' %></th>
            <th class="rate-col">Rate</th>
            <th class="invoice-number-cell">Item value (UGX)</th>
            <% if (stockEntryReadOnly) { %>
            <th class="tracking-info">Created by</th>
            <th class="tracking-info">Updated by</th>
            <% } %>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="row-number">1</td>
            <td class="item-code-col">
              <input type="hidden" name="id" value="">
              <input name="item_code" aria-label="Item code" placeholder="Search and select item" autocomplete="off" required>
              <input type="hidden" name="item_name">
              <div class="results stock-item-results"></div>
            </td>
            <td class="warehouse-col">
              <div class="warehouse-balance-pair">
                <input name="warehouse" list="stock-warehouses" autocomplete="off" required>
                <div class="stock-balance-field" data-balance-field="warehouse_balance">Balance: 0</div>
              </div>
            </td>
            <td class="warehouse-col">
              <div class="warehouse-balance-pair">
                <input name="target_warehouse" list="stock-warehouses" autocomplete="off">
                <div class="stock-balance-field" data-balance-field="target_warehouse_balance">Balance: 0</div>
              </div>
            </td>
            <td><input name="quantity" type="number" step="0.001" <%= selectedEntryType === 'reconciliation' ? 'min="0"' : '' %> required></td>
            <td class="rate-col"><input class="rate-input" name="valuation_rate" type="number" step="1" value="0"></td>
            <td class="invoice-number-cell"><output data-item-value>0</output></td>
            <% if (stockEntryReadOnly) { %>
            <td class="tracking-info"></td>
            <td class="tracking-info"></td>
            <% } %>
            <td><button type="button" class="button-light" data-remove-row>Remove</button></td>
          </tr>
        </tbody>
      </table></div>

      <p class="invoice-number-cell">Total item value (UGX): <strong><output id="stock-entry-total-value" aria-live="polite">0</output></strong></p>
      <div class="actions ui-form-footer">
        <button type="button" class="button-light" id="add-stock-row">Add Row</button>
        <% if (!stockEntryReadOnly) { %>
          <input type="file" id="stock-entry-import-file" accept=".csv,.tsv,.txt,text/csv,text/tab-separated-values" hidden>
          <button type="button" class="button-light" id="import-stock-entry-rows">Import CSV</button>
          <span class="field-hint" id="stock-entry-import-status"></span>
        <% } %>
        <% if (can('vouchers.stock.cancel')) { %><button type="button" class="button-light" id="cancel-entry-button" hidden disabled>Cancel Stock Entry</button><% } %>
      </div>
    </form>
    <% if (entry && entry.id) { %><%- include('record-audit', { record: entry }) %><% } %>
    <% } %>
  </main>
  <% if (!stockEntryReadOnly) { %>
    <dialog class="voucher-dialog supplier-dialog" id="supplier-dialog" aria-labelledby="supplier-dialog-title">
    <div class="voucher-dialog-header">
      <h2 id="supplier-dialog-title">Supplier Information</h2>
      <button type="button" class="button-light" data-supplier-cancel>Close</button>
    </div>
    <form class="voucher-dialog-body supplier-form" method="dialog" id="supplier-form">
      <label>
        Supplier Name
        <input name="supplier_name" autocomplete="organization">
      </label>
      <label>
        Contact Person
        <input name="supplier_contact" autocomplete="name">
      </label>
      <label>
        Phone
        <input name="supplier_phone" autocomplete="tel">
      </label>
      <label>
        Receipt / Invoice Reference
        <input name="supplier_reference">
      </label>
      <div class="actions ui-form-footer">
        <button type="button" class="button-light" data-supplier-cancel>Cancel</button>
        <button type="submit">Save Supplier Info</button>
      </div>
    </form>
    </dialog>
  <% } %>
  <% if (!stockEntryReadOnly) { %>
  <script>
    window.STOCK_ENTRY_INITIAL = <%- scriptJson({ entry: entry || null, items: items || [], readOnly: stockEntryReadOnly, transferTypes: stockTransferTypes }) %>;
  </script>
  <script src="/stock-entry.js?v=<%= assetVersion %>"></script>
  <script src="/cost-center-field.js?v=<%= assetVersion %>"></script>
  <% } %>
</body>
</html>
