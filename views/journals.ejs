<!doctype html>
<html lang="en">
<head>
  <title>Journals</title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell ui-page ui-page-list ui-list-compact">
    <header class="topbar">
      <div>
        <p class="eyebrow">Accounting</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Home', href: '/' }, { label: 'Accounts', href: '/accounts' }, { label: 'Journals' }] }) %>
      </div>
      <nav>
        <%- include('module-nav', { activeModule: 'accounts' }) %>
        <%- include('journal-new-button') %>
      </nav>
    </header>
    <%- include('voucher-report-tabs', { basePath: '/journals', title: 'Journal', activeTab: 'list' }) %>

    <form class="report-filters journal-filters ui-toolbar ui-filter-row" method="get">
      <label>
        Search
        <input name="q" value="<%= search %>" placeholder="Search journals">
      </label>
      <label>
        Type
        <select name="journal_type">
          <option value="">All Types</option>
          <option value="cash_receipt" <%= query.journal_type === 'cash_receipt' ? 'selected' : '' %>>Cash Receipt</option>
          <option value="payment_journal" <%= query.journal_type === 'payment_journal' ? 'selected' : '' %>>Payment Journal</option>
          <option value="sales_invoice" <%= query.journal_type === 'sales_invoice' ? 'selected' : '' %>>Sales Invoice</option>
          <option value="journal_entry" <%= query.journal_type === 'journal_entry' ? 'selected' : '' %>>Journal Entry</option>
        </select>
      </label>
      <label>
        Status
        <select name="status">
          <option value="">All Statuses</option>
          <option value="draft" <%= query.status === 'draft' ? 'selected' : '' %>>Draft</option>
          <option value="submitted" <%= query.status === 'submitted' ? 'selected' : '' %>>Submitted</option>
          <option value="cancelled" <%= query.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
        </select>
      </label>
      <div class="report-filter-actions">
        <button type="submit">Apply</button>
        <a class="button button-light" href="/journals">Reset</a>
      </div>
    </form>

    <section class="invoice-card report-section ui-surface ui-results">
      <%- include('ui-section-heading', { heading: { title: 'Results', meta: pagination ? (pagination.total == null ? (pagination.end ? `${pagination.start}–${pagination.end} shown` : '0 records') : `${pagination.total} records`) : '' } }) %>
      <div class="ui-table-scroll" role="region" aria-label="Journals table" tabindex="0"><table class="ui-table">
        <thead>
          <tr>
            <th class="row-number">#</th>
            <th>Journal</th>
            <th>Date</th>
            <th>Type</th>
            <th>Party</th>
            <th>Reference</th>
            <th class="ui-amount">Debit</th>
            <th class="ui-amount">Credit</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (!journals.length) { %>
            <tr><td colspan="9" class="empty">No journal entries found.</td></tr>
          <% } %>
          <% journals.forEach((journal, index) => { %>
            <% const docstatus = journal.docstatus || 'submitted'; %>
            <tr>
              <td class="row-number"><%= (pagination ? pagination.offset : 0) + index + 1 %></td>
              <td><a href="/journals/<%= journal.id %>" data-voucher-drawer="/journals/<%= journal.id %>/drawer"><%= journal.journal_no %></a></td>
              <td><%= formatDate(journal.posting_date) %></td>
              <td><%= journalTypeLabel(journal.journal_type) %></td>
              <td><%= journal.party_type === 'employee' ? journal.party_name || journal.party_id || '' : journal.party_id || '' %></td>
              <td><%= journal.reference_no || journal.source_references || '' %></td>
              <td class="ui-amount"><%= money(journal.total_debit) %></td>
              <td class="ui-amount"><%= money(journal.total_credit) %></td>
              <td><span class="badge <%= docstatus %>"><%= docstatus === 'draft' ? 'Draft' : docstatus === 'cancelled' ? 'Cancelled' : 'Submitted' %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
      <%- include('pagination', { pagination, query, basePath: '/journals' }) %>
    </section>
  </main>
</body>
</html>
