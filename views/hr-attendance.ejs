<% if(can('hr.attendance.create')){ %><section class="invoice-card hr-card"><h2>Record a team’s attendance</h2><form action="/hr/attendance" method="post" class="hr-grid"><%- include('hr-employee-select',{label:'Employees',name:'employee_ids',multiple:true,activeOnly:true}) %><label>Date<input type="date" name="attendance_date" value="<%= today %>" required></label><label>Status<select name="status"><option value="present">Present</option><option value="absent">Absent</option><option value="half_day">Half day</option></select></label><label>Notes<textarea name="notes" maxlength="2000"></textarea></label><div><button class="button">Save drafts</button></div></form></section><% } %>
<section class="invoice-card hr-card"><h2>Attendance register</h2><form method="get" class="hr-grid"><label>Date<input type="date" name="date" value="<%= filterDate %>"></label><div><button class="button secondary">Filter</button> <a href="/hr/attendance">Clear</a></div></form><p class="muted">Up to 1,000 recent records. Missing records are unrecorded attendance and do not become salary deductions automatically.</p>
<div class="table-wrap"><table><thead><tr><th>Date</th><th>Employee</th><th>Attendance</th><th>Notes</th><th>Status</th><th>Actions</th></tr></thead><tbody><% records.forEach(r=>{ %><tr><td><%= formatDate(r.attendance_date) %></td><td><%= r.employee_name %></td><td><%= r.status.replaceAll('_',' ') %></td><td><%= r.notes %></td><td><span class="badge <%= r.docstatus %>"><%= r.docstatus %></span></td><td class="hr-actions"><% if(r.docstatus==='draft'&&can('hr.attendance.submit')){ %><form method="post" action="/hr/attendance/<%= r.id %>/submit"><button class="button secondary">Submit</button></form><% } %><% if(r.docstatus!=='cancelled'&&can('hr.attendance.cancel')){ %><form method="post" action="/hr/attendance/<%= r.id %>/cancel"><button class="button secondary" data-confirm="Cancel this attendance record?">Cancel</button></form><% } %></td></tr><% }) %></tbody></table></div></section>
