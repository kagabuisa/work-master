<% const editing = Boolean(invoice && invoice.id); %>
<% const savedListAllowed = !editing || typeof invoicePriceListAllowed !== 'function' || invoicePriceListAllowed(invoice.price_list); %>
<!doctype html>
<html lang="en">
<head>
  <title><%= editing ? `Edit ${invoice.invoice_no}` : 'New Invoice' %></title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">Sales</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Dashboard', href: '/' }, { label: 'Invoices', href: '/invoices' }, { label: editing ? 'Edit' : 'New' }] }) %>
      </div>
      <nav>
        <%- include('module-nav', { activeModule: 'sales' }) %>
        <div class="actions page-actions">
          <button type="button" class="button-light" id="refresh-invoice-prices">Refresh Prices</button>
          <% if (editing && savedListAllowed && can('vouchers.sales.submit') && can('payments.sales.record')) { %>
            <button type="button" data-edit-submit-action data-cash-sale-url="/invoices/<%= invoice.id %>/submit-cash-sale" data-cash-sale-total="<%= invoice.total %>" data-cash-sale-date="<%= invoice.invoice_date %>" data-cash-sale-invoice="<%= invoice.invoice_no %>" data-cash-sale-customer="<%= invoice.customer_name %>" data-cash-sale-accounts="<%= JSON.stringify(typeof receiptAccounts !== 'undefined' ? receiptAccounts : []) %>">Submit Cash Sale</button>
          <% } %>
          <% if (editing && savedListAllowed && can('vouchers.sales.submit')) { %>
            <form method="post" action="/invoices/<%= invoice.id %>/submit" class="inline-form" data-edit-submit-action data-confirm="Submit this credit invoice? Stock will be reduced and the total will remain outstanding on the customer's account.">
              <button type="submit" class="button-light">Submit Invoice</button>
            </form>
          <% } %>
          <button type="submit" form="invoice-form" data-voucher-save data-edit-save<%= editing && savedListAllowed && can('vouchers.sales.submit') ? ' hidden' : '' %>>Save</button>
        </div>
      </nav>
    </header>
    <% if (typeof duplicateOf !== 'undefined' && duplicateOf) { %>
      <section class="notice" role="status">Copy of <strong><%= duplicateOf %></strong>. Review the details, then save this as a new draft.</section>
    <% } %>
    <% if (typeof stockWarning !== 'undefined' && stockWarning) { %>
      <section class="notice warning">
        <strong>Adjust quantity before submitting.</strong>
        <p>
          <%= stockWarning.item_name %> requested quantity is
          <%= Number(stockWarning.requested).toLocaleString() %>, but only
          <%= Number(stockWarning.available).toLocaleString() %> is available in
          <%= stockWarning.warehouse %>.
        </p>
      </section>
    <% } %>
    <% if (typeof formError !== 'undefined' && formError) { %>
      <section class="notice warning" role="alert"><strong><%= formError %></strong><p>Your entries are preserved below. Review them and save again.</p></section>
    <% } %>
    <section class="notice warning" id="invoice-form-error" role="alert" hidden>
      <strong></strong>
    </section>

    <form id="invoice-form" method="post" action="<%= editing ? `/invoices/${invoice.id}` : '/invoices' %>" class="invoice-form entry-form new-invoice-form" data-static-labels data-voucher-form>
      <section class="invoice-entry-row">
        <div class="form-field app-floating-field app-floating-choice">
          <label class="field-label app-floating-label" for="invoice-date">Invoice Date</label>
          <input id="invoice-date" type="date" name="invoice_date" value="<%= invoice ? invoice.invoice_date : today %>" required>
        </div>
        <div class="form-field app-floating-field app-floating-choice">
          <label class="field-label app-floating-label" for="invoice-posting-time">Posting Time</label>
          <input id="invoice-posting-time" type="time" name="posting_time" value="<%= invoice && invoice.posting_time !== undefined ? invoice.posting_time : currentPostingTime() %>" required>
        </div>
        <div class="form-field app-floating-field app-floating-choice">
          <label class="field-label app-floating-label" for="due-date">Due Date</label>
          <input id="due-date" type="date" name="due_date" value="<%= invoice && invoice.due_date ? invoice.due_date : '' %>">
        </div>
        <div class="form-field app-floating-field app-floating-choice">
          <label class="field-label app-floating-label" for="non-system-invoice">Non-System Invoice</label>
          <input id="non-system-invoice" name="non_system_invoice" value="<%= invoice && invoice.non_system_invoice || '' %>" maxlength="100" autocomplete="off">
        </div>
        <div class="form-field lookup-field app-floating-field app-floating-choice invoice-customer-field">
          <label class="field-label app-floating-label" for="customer-search">Customer</label>
          <input id="customer-search" name="customer_name" autocomplete="off" placeholder="Search and select customer" value="<%= invoice ? invoice.customer_name : '' %>" required>
          <input type="hidden" name="customer_id" id="customer-id" value="<%= invoice && invoice.customer_id ? invoice.customer_id : '' %>">
          <div id="customer-results" class="results"></div>
        </div>
        <div class="invoice-context-row">
          <div class="form-field app-floating-field app-floating-choice">
            <label class="field-label app-floating-label" for="invoice-price-list">Price List</label>
            <select id="invoice-price-list" name="price_list" required>
              <option value="<%= invoice && invoice.price_list || '' %>"><%= invoice && invoice.price_list || 'Loading price lists...' %></option>
            </select>
          </div>
          <div class="form-field app-floating-field app-floating-choice">
            <label class="field-label app-floating-label" for="invoice-cost-center">Cost Center</label>
            <input id="invoice-cost-center" name="cost_center" list="invoice-cost-centers" value="<%= invoice && invoice.cost_center || '' %>" autocomplete="off" placeholder="Search cost centers">
            <datalist id="invoice-cost-centers"></datalist>
          </div>
          <div class="form-field lookup-field app-floating-field app-floating-choice">
            <label class="field-label app-floating-label" for="invoice-invoicer">Invoicer</label>
            <input id="invoice-invoicer" name="invoicer" value="<%= invoice && invoice.invoicer || '' %>" autocomplete="off" placeholder="Search and select employee" required>
            <input type="hidden" id="invoice-invoicer-id" name="invoicer_id" value="<%= invoice && invoice.invoicer_id || '' %>">
            <div id="invoice-invoicer-results" class="results"></div>
          </div>
        </div>
        <div class="form-field app-floating-field app-floating-choice">
          <label class="field-label app-floating-label" for="warehouse-select">Warehouse</label>
          <select id="warehouse-select" name="warehouse" required>
            <option value="<%= invoice && invoice.warehouse || (items[0] ? items[0].warehouse : '') %>"><%= invoice && invoice.warehouse || (items[0] ? items[0].warehouse : 'Loading warehouses...') %></option>
          </select>
        </div>
        <div class="form-field lookup-field app-floating-field app-floating-choice">
          <label class="field-label app-floating-label" for="item-search">Add Item</label>
          <input id="item-search" autocomplete="off" placeholder="Choose a warehouse first" disabled>
          <div id="item-results" class="results"></div>
        </div>
      </section>
      <p class="field-hint invoice-price-update-status" id="invoice-price-update-status" role="status" hidden></p>

      <div class="entry-table-scroll" role="region" aria-label="Invoice items" tabindex="0">
      <table id="invoice-items" class="editable entry-table">
        <thead>
          <tr>
            <th class="row-number">#</th>
            <th class="item-code-col">Item Name</th>
            <th>Stock</th>
            <th>Qty</th>
            <th>Unit Price</th>
            <th>Total</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <tr class="empty-row"><td colspan="7" class="empty">Search and add items to begin.</td></tr>
        </tbody>
      </table>
      </div>

      <section class="form-grid totals-form">
        <label class="app-floating-field app-floating-choice">
          <span class="app-floating-label">Discount</span>
          <input type="number" min="0" step="1" name="discount_amount" value="<%= invoice ? invoice.discount_amount : 0 %>">
        </label>
        <label class="app-floating-field app-floating-choice">
          <span class="app-floating-label">Tax</span>
          <input type="number" min="0" step="1" name="tax_amount" value="<%= invoice ? invoice.tax_amount : 0 %>">
        </label>
        <div class="live-total">
          <span>Total</span>
          <strong id="grand-total">Ugx 0</strong>
        </div>
        <div class="live-total">
          <span>Paid</span>
          <strong id="paid-total">Ugx 0</strong>
        </div>
        <div class="live-total">
          <span>Balance</span>
          <strong id="balance-total">Ugx 0</strong>
        </div>
        <div class="live-total">
          <span>Status</span>
          <strong id="payment-status">Unpaid</strong>
        </div>
        <label class="wide app-floating-field app-floating-choice app-floating-textarea">
          <span class="app-floating-label">Notes</span>
          <textarea name="notes" rows="3" placeholder="Payment terms or delivery note"><%= invoice && invoice.notes ? invoice.notes : '' %></textarea>
        </label>
      </section>

      <section class="payments-entry" hidden>
        <div class="section-title">
          <h2>Payments</h2>
        </div>
        <table id="invoice-payments" class="editable">
          <thead>
            <tr>
              <th class="row-number">#</th>
              <th>Date</th>
              <th>Account</th>
              <th>Payment Reference</th>
              <th>Notes</th>
              <th>Amount</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <tr class="empty-row"><td colspan="7" class="empty">No payments added.</td></tr>
          </tbody>
        </table>
        <div class="payment-form invoice-payment-form">
          <label>
            Payment Date
            <input type="date" id="payment-date" value="<%= today %>">
          </label>
          <label>
            Amount
            <input type="number" min="1" step="1" id="payment-amount">
          </label>
          <label>
            Account
            <select id="payment-account">
              <option value="">Choose cash or bank account</option>
              <% (typeof receiptAccounts !== 'undefined' ? receiptAccounts : []).forEach((account) => { %>
                <option value="<%= account.id %>"><%= account.account_code ? `${account.account_code} · ` : '' %><%= account.account_name %></option>
              <% }) %>
            </select>
          </label>
          <label>
            Payment Reference
            <input id="payment-reference" placeholder="Optional">
          </label>
          <label class="wide">
            Notes
            <input id="payment-notes" placeholder="Optional">
          </label>
          <div class="payment-submit">
            <button type="button" id="add-payment">Add Payment</button>
          </div>
        </div>
      </section>

      <input type="hidden" name="items_json" id="items-json">
      <input type="hidden" name="payments_json" id="payments-json">
    </form>
  </main>
  <script>
    window.invoiceInitial = <%- JSON.stringify({
      invoice,
      items,
      warehouse: invoice && invoice.warehouse || (items[0] ? items[0].warehouse : ''),
      recovered: typeof formError !== 'undefined' && Boolean(formError),
    }).replace(/</g, '\\u003c') %>;
  </script>
  <script src="/invoice.js?v=<%= assetVersion %>"></script>
</body>
</html>
