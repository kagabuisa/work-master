<!doctype html>
<html lang="en">
<head>
  <title>Stock Movement</title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">Inventory</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Dashboard', href: '/' }, { label: 'Stock', href: '/stock' }, { label: 'Movement' }] }) %>
      </div>
      <nav>
        <%- include('module-nav', { activeModule: 'report' }) %>
      </nav>
    </header>
    <form class="report-filters" method="get">
      <datalist id="stock-report-warehouses"></datalist>
      <label>
        Item
        <input name="q" value="<%= report.filters.search %>" placeholder="Search stock movement" autocomplete="off" data-stock-report-item>
        <div class="results stock-report-item-results"></div>
      </label>
      <label>
        Warehouse
        <input name="warehouse" value="<%= report.filters.warehouse %>" placeholder="Warehouse" list="stock-report-warehouses" autocomplete="off">
      </label>
      <label>From<input type="date" name="from" value="<%= report.filters.from %>"></label>
      <label>To<input type="date" name="to" value="<%= report.filters.to %>"></label>
      <div class="report-filter-actions">
        <button type="submit">Apply</button>
        <a class="button button-light" href="/reports/stock-movement">Reset</a>
      </div>
    </form>
    <script src="/stock-report-filters.js"></script>
    <section class="invoice-card report-section">
      <table>
        <thead>
          <tr>
            <th class="item-code-col">Item</th>
            <th class="warehouse-col">Warehouse</th>
            <th>Opening Qty</th>
            <th>In Qty</th>
            <th>Out Qty</th>
            <th>Closing Qty</th>
            <th>Opening Value</th>
            <th>Value Change</th>
            <th>Closing Value</th>
          </tr>
        </thead>
        <tbody>
          <% if (!report.rows.length) { %><tr><td colspan="9" class="empty">No stock movement found.</td></tr><% } %>
          <% report.rows.forEach((row, index) => {
            const inDetails = Array.isArray(row.in_details) ? row.in_details : [];
            const outDetails = Array.isArray(row.out_details) ? row.out_details : [];
            const inDetailsId = `movement-in-details-${index}`;
            const outDetailsId = `movement-out-details-${index}`;
          %>
            <tr>
              <td class="item-code-col"><strong><%= row.item_code %></strong></td>
              <td class="warehouse-col"><%= row.warehouse %></td>
              <td><%= Number(row.opening_qty || 0).toLocaleString() %></td>
              <td>
                <% if (inDetails.length) { %>
                  <button type="button" class="quantity-link" data-movement-toggle="<%= inDetailsId %>" aria-expanded="false">
                    <%= Number(row.in_qty || 0).toLocaleString() %>
                  </button>
                <% } else { %>
                  <%= Number(row.in_qty || 0).toLocaleString() %>
                <% } %>
              </td>
              <td>
                <% if (outDetails.length) { %>
                  <button type="button" class="quantity-link" data-movement-toggle="<%= outDetailsId %>" aria-expanded="false">
                    <%= Number(row.out_qty || 0).toLocaleString() %>
                  </button>
                <% } else { %>
                  <%= Number(row.out_qty || 0).toLocaleString() %>
                <% } %>
              </td>
              <td><%= Number(row.closing_qty || 0).toLocaleString() %></td>
              <td><%= money(row.opening_value) %></td>
              <td><%= money(row.value_change) %></td>
              <td><strong><%= money(row.closing_value) %></strong></td>
            </tr>
            <% if (inDetails.length) { %>
              <tr class="movement-detail-row" id="<%= inDetailsId %>" hidden>
                <td colspan="9">
                  <div class="movement-detail">
                    <h2>In Qty details for <%= row.item_code %> - <%= row.warehouse %></h2>
                    <table>
                      <thead>
                        <tr>
                          <th>Date</th>
                          <th>Voucher</th>
                          <th>Type</th>
                          <th>Qty</th>
                          <th>Rate</th>
                          <th>Value</th>
                          <th>Balance Qty</th>
                          <th>Balance Value</th>
                          <th>Remarks</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% inDetails.forEach((detail) => { %>
                          <tr>
                            <td><%= detail.posting_date %></td>
                            <td>
                              <% if (detail.voucher_id && String(detail.voucher_type || '').startsWith('stock_')) { %>
                                <a class="voucher-link" href="/stock/entries/<%= detail.voucher_id %>"><%= detail.voucher_no || detail.voucher_type %></a>
                              <% } else { %>
                                <%= detail.voucher_no || detail.voucher_type %>
                              <% } %>
                            </td>
                            <td><%= detail.stock_entry_type || '' %></td>
                            <td><%= Number(detail.qty || 0).toLocaleString() %></td>
                            <td><%= detail.rate ? money(detail.rate) : '' %></td>
                            <td><%= money(detail.value) %></td>
                            <td><%= Number(detail.balance_qty || 0).toLocaleString() %></td>
                            <td><%= money(detail.balance_value) %></td>
                            <td><%= detail.remarks || '' %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                      <tfoot>
                        <tr>
                          <th colspan="3">Total</th>
                          <th><%= Number(row.in_qty || 0).toLocaleString() %></th>
                          <th></th>
                          <th><%= money(inDetails.reduce((sum, detail) => sum + Number(detail.value || 0), 0)) %></th>
                          <th colspan="3"></th>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                </td>
              </tr>
            <% } %>
            <% if (outDetails.length) { %>
              <tr class="movement-detail-row" id="<%= outDetailsId %>" hidden>
                <td colspan="9">
                  <div class="movement-detail">
                    <h2>Out Qty details for <%= row.item_code %> - <%= row.warehouse %></h2>
                    <table>
                      <thead>
                        <tr>
                          <th>Date</th>
                          <th>Voucher</th>
                          <th>Type</th>
                          <th>Qty</th>
                          <th>Rate</th>
                          <th>Value</th>
                          <th>Balance Qty</th>
                          <th>Balance Value</th>
                          <th>Remarks</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% outDetails.forEach((detail) => { %>
                          <tr>
                            <td><%= detail.posting_date %></td>
                            <td>
                              <% if (detail.voucher_id && String(detail.voucher_type || '').startsWith('stock_')) { %>
                                <a class="voucher-link" href="/stock/entries/<%= detail.voucher_id %>"><%= detail.voucher_no || detail.voucher_type %></a>
                              <% } else { %>
                                <%= detail.voucher_no || detail.voucher_type %>
                              <% } %>
                            </td>
                            <td><%= detail.stock_entry_type || '' %></td>
                            <td><%= Number(detail.qty || 0).toLocaleString() %></td>
                            <td><%= detail.rate ? money(detail.rate) : '' %></td>
                            <td><%= money(detail.value) %></td>
                            <td><%= Number(detail.balance_qty || 0).toLocaleString() %></td>
                            <td><%= money(detail.balance_value) %></td>
                            <td><%= detail.remarks || '' %></td>
                          </tr>
                        <% }) %>
                      </tbody>
                      <tfoot>
                        <tr>
                          <th colspan="3">Total</th>
                          <th><%= Number(row.out_qty || 0).toLocaleString() %></th>
                          <th></th>
                          <th><%= money(outDetails.reduce((sum, detail) => sum + Number(detail.value || 0), 0)) %></th>
                          <th colspan="3"></th>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                </td>
              </tr>
            <% } %>
          <% }) %>
        </tbody>
      </table>
    </section>
  </main>
  <script src="/stock-movement.js"></script>
</body>
</html>
