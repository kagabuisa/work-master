<!doctype html>
<html lang="en">
<head>
  <title>Stock Movement</title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">Inventory</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Home', href: '/' }, { label: 'Stocks', href: '/stock/entries' }, { label: 'Stock Movement' }] }) %>
      </div>
      <nav>
        <%- include('module-nav', { activeModule: 'stock' }) %>
      </nav>
    </header>
    <form class="report-filters stock-movement-filters" method="get">
      <datalist id="stock-report-warehouses"></datalist>
      <label>
        Item
        <input name="q" value="<%= report.filters.search %>" placeholder="Search stock movement" autocomplete="off" data-stock-report-item>
        <div class="results stock-report-item-results"></div>
      </label>
      <label>
        Warehouse
        <input name="warehouse" value="<%= report.filters.warehouse %>" placeholder="Warehouse" list="stock-report-warehouses" autocomplete="off">
      </label>
      <label>From<input type="date" name="from" value="<%= report.filters.from %>"></label>
      <label>To<input type="date" name="to" value="<%= report.filters.to %>"></label>
      <div class="report-filter-actions">
        <button type="submit">Apply</button>
        <a class="button button-light" href="/reports/stock-movement">Reset</a>
      </div>
    </form>
    <script src="/stock-report-filters.js"></script>
    <section class="metrics">
      <article><span>Opening Qty</span><strong><%= Number(report.summary.opening_qty || 0).toLocaleString() %></strong></article>
      <article><span>In Qty</span><strong><%= Number(report.summary.in_qty || 0).toLocaleString() %></strong></article>
      <article><span>Out Qty</span><strong><%= Number(report.summary.out_qty || 0).toLocaleString() %></strong></article>
      <article><span>Closing Value</span><strong><%= money(report.summary.closing_value || 0) %></strong></article>
    </section>
    <section class="invoice-card report-section">
      <table>
        <thead>
          <tr>
            <th class="row-number">#</th>
            <th class="item-code-col">Item Name</th>
            <th class="warehouse-col">Warehouse</th>
            <th>Opening Qty</th>
            <th>In Qty</th>
            <th>Out Qty</th>
            <th>Closing Qty</th>
            <th>Opening Value</th>
            <th>Value Change</th>
            <th>Closing Value</th>
          </tr>
        </thead>
        <tbody>
          <% if (!report.rows.length) { %><tr><td colspan="10" class="empty">No stock movement found.</td></tr><% } %>
          <% report.rows.forEach((row, index) => {
            const inDetailsId = `movement-in-details-${index}`;
            const outDetailsId = `movement-out-details-${index}`;
          %>
            <tr>
              <td class="row-number"><%= (report.pagination ? report.pagination.offset : 0) + index + 1 %></td>
              <td class="item-code-col"><strong><%= row.item_code %></strong></td>
              <td class="warehouse-col"><%= row.warehouse %></td>
              <td><%= Number(row.opening_qty || 0).toLocaleString() %></td>
              <td>
                <% if (Number(row.in_qty || 0) > 0) { %>
                  <button
                    type="button"
                    class="quantity-link"
                    data-movement-toggle="<%= inDetailsId %>"
                    data-item-code="<%= row.item_code %>"
                    data-warehouse="<%= row.warehouse %>"
                    data-direction="in"
                    data-title="In Qty details for <%= row.item_code %> - <%= row.warehouse %>"
                    aria-expanded="false"
                  >
                    <%= Number(row.in_qty || 0).toLocaleString() %>
                  </button>
                <% } else { %>
                  <%= Number(row.in_qty || 0).toLocaleString() %>
                <% } %>
              </td>
              <td>
                <% if (Number(row.out_qty || 0) > 0) { %>
                  <button
                    type="button"
                    class="quantity-link"
                    data-movement-toggle="<%= outDetailsId %>"
                    data-item-code="<%= row.item_code %>"
                    data-warehouse="<%= row.warehouse %>"
                    data-direction="out"
                    data-title="Out Qty details for <%= row.item_code %> - <%= row.warehouse %>"
                    aria-expanded="false"
                  >
                    <%= Number(row.out_qty || 0).toLocaleString() %>
                  </button>
                <% } else { %>
                  <%= Number(row.out_qty || 0).toLocaleString() %>
                <% } %>
              </td>
              <td><%= Number(row.closing_qty || 0).toLocaleString() %></td>
              <td><%= money(row.opening_value) %></td>
              <td><%= money(row.value_change) %></td>
              <td><strong><%= money(row.closing_value) %></strong></td>
            </tr>
            <tr class="movement-detail-row" id="<%= inDetailsId %>" hidden><td colspan="10"><div class="movement-detail" data-movement-detail></div></td></tr>
            <tr class="movement-detail-row" id="<%= outDetailsId %>" hidden><td colspan="10"><div class="movement-detail" data-movement-detail></div></td></tr>
          <% }) %>
        </tbody>
      </table>
      <%- include('pagination', { pagination: report.pagination, query, basePath: '/reports/stock-movement' }) %>
    </section>
  </main>
  <script src="/stock-movement.js"></script>
</body>
</html>
