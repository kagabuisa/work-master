<!doctype html>
<html lang="en">
<head>
  <title>Purchases</title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell ui-page ui-page-list ui-list-compact">
    <header class="topbar">
      <div>
        <p class="eyebrow">Purchases</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Home', href: '/' }, { label: 'Purchases', href: '/purchases' }, { label: 'Purchase Invoices' }] }) %>
      </div>
      <nav><%- include('module-nav', { activeModule: 'purchases' }) %><%- include('purchase-new-menu') %></nav>
    </header>
    <%- include('voucher-report-tabs', { basePath: '/purchases', title: 'Purchase Invoice', activeTab: 'list' }) %>
    <form class="report-filters invoice-filters ui-toolbar ui-filter-row" method="get" action="/purchases">
      <label>Search<input name="q" value="<%= query.q || '' %>" placeholder="Number or supplier"></label>
      <label>From<input type="date" name="from" value="<%= query.from || '' %>"></label>
      <label>To<input type="date" name="to" value="<%= query.to || '' %>"></label>
      <div class="report-filter-actions">
        <button type="submit">Apply</button>
        <a class="button button-light" href="/purchases">Reset</a>
      </div>
    </form>
    <section class="invoice-card report-section ui-surface ui-results">
      <%- include('ui-section-heading', { heading: { title: 'Results', meta: `${result.pagination.total} records` } }) %>
      <div class="ui-table-scroll" role="region" aria-label="Purchases table" tabindex="0"><table class="ui-table">
        <thead><tr><th>#</th><th>Purchase</th><th>Date/Time</th><th>Supplier</th><th>Reference</th><th class="ui-amount">Total</th><th class="ui-amount">Paid</th><th class="ui-amount">Balance</th><th>Document</th><th>Payment</th></tr></thead>
        <tbody>
          <% if (!result.rows.length) { %><tr><td colspan="10" class="empty">No purchases found.</td></tr><% } %>
          <% result.rows.forEach((purchase, index) => { %>
            <tr>
              <td><%= (result.pagination ? result.pagination.offset : (result.page - 1) * 25) + index + 1 %></td>
              <td><a href="/purchases/<%= purchase.id %>" data-voucher-drawer="/purchases/<%= purchase.id %>/drawer"><%= purchase.purchase_no %></a></td>
              <td><%= formatDateTime(purchase.posting_date, purchase.posting_time || '00:00') %></td>
              <td><%= purchase.supplier_name %></td>
              <td><%= purchase.supplier_reference || '' %></td>
              <td class="ui-amount"><%= money(purchase.total) %></td>
              <td class="ui-amount"><%= money(purchase.amount_paid) %></td>
              <td class="ui-amount"><%= money(purchase.total - purchase.amount_paid) %></td>
              <td><span class="badge <%= purchase.docstatus %>"><%= purchase.docstatus %></span></td>
              <td><span class="badge <%= purchase.status %>"><%= purchase.status %></span></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
      <%- include('pagination', { pagination: result.pagination, query, basePath: '/purchases' }) %>
    </section>
  </main>
</body>
</html>
