<section class="invoice-card hr-card ui-surface"><%- include('ui-section-heading', { heading: { title: 'Individual payslips', help: 'Individual payslips follow your employee and account permissions. Payroll run totals require permission for every employee in the run.' } }) %><div class="ui-toolbar ui-filter-row"><label>Find payslip<input type="search" data-hr-search placeholder="Employee or month"></label></div><div class="table-wrap ui-table-scroll"><table class="ui-table" data-hr-filter><thead><tr><th>Employee</th><th>Month</th><th>Company</th><th>Gross</th><th>Deductions</th><th>Net</th><th>Paid</th><th>Status</th></tr></thead><tbody><% if(!slips.length){ %><tr><td colspan="8" class="empty">No payslips in your permitted scope.</td></tr><% } %><% slips.forEach(s=>{ %><tr><td><a href="/hr/payslips/<%= s.id %>"><%= s.employee_name %></a></td><td><%= s.period %></td><td><%= s.company %></td><td class="ui-amount"><%= money(s.gross_pay) %></td><td class="ui-amount"><%= money(s.deductions) %></td><td class="ui-amount"><%= money(s.net_pay) %></td><td class="ui-amount"><%= money(s.paid_amount) %></td><td><%= s.docstatus %></td></tr><% }) %></tbody></table></div></section>
