<section class="invoice-card hr-card"><p>Individual payslips within your employee and account permissions. Payroll run totals require permission for every employee in the run.</p><label>Find payslip<input type="search" data-hr-search placeholder="Employee or month"></label><div class="table-wrap"><table data-hr-filter><thead><tr><th>Employee</th><th>Month</th><th>Company</th><th>Gross</th><th>Deductions</th><th>Net</th><th>Paid</th><th>Status</th></tr></thead><tbody><% slips.forEach(s=>{ %><tr><td><a href="/hr/payslips/<%= s.id %>"><%= s.employee_name %></a></td><td><%= s.period %></td><td><%= s.company %></td><td><%= money(s.gross_pay) %></td><td><%= money(s.deductions) %></td><td><%= money(s.net_pay) %></td><td><%= money(s.paid_amount) %></td><td><%= s.docstatus %></td></tr><% }) %></tbody></table></div></section>
