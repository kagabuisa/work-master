<!doctype html>
<html lang="en">
<head>
  <title>Debtor Report</title>
  <%- include('partials-head') %>
</head>
<body>
  <%
    const statementParams = new URLSearchParams();
    if (report.filters.customer) statementParams.set('customer', report.filters.customer);
    if (report.filters.search) statementParams.set('q', report.filters.search);
    if (report.filters.from) statementParams.set('from', report.filters.from);
    if (report.filters.to) statementParams.set('to', report.filters.to);
    if (report.filters.statement_from && report.filters.statement_from !== report.filters.from) statementParams.set('statement_from', report.filters.statement_from);
    if (report.filters.statement_to && report.filters.statement_to !== report.filters.to) statementParams.set('statement_to', report.filters.statement_to);
    const closeParams = new URLSearchParams();
    if (report.filters.search) closeParams.set('q', report.filters.search);
    if (report.filters.from) closeParams.set('from', report.filters.from);
    if (report.filters.to) closeParams.set('to', report.filters.to);
    closeParams.set('view', 'list');
    const isFullStatement = Boolean(report.selected && query.view === 'full');
    const paymentInvoiceId = report.paymentInvoiceId || (report.statement && report.statement.find((entry) => entry.type === 'Invoice' && Number(entry.balance_due || 0) > 0)?.invoice_id);
    const isPaymentView = Boolean(report.selected && query.view === 'payment' && paymentData);
    const isListView = !isFullStatement && !isPaymentView;
    const paymentParams = new URLSearchParams(statementParams);
    paymentParams.set('view', 'payment');
    const paymentReturnTo = `/reports/debtors?${paymentParams.toString()}`;
  %>
  <main class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">Reports</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Home', href: '/' }, { label: 'Sales', href: '/invoices' }, { label: 'Debtors' }] }) %>
      </div>
      <nav>
        <%- include('module-nav', { activeModule: 'sales' }) %>
      </nav>
    </header>
    <nav class="debtor-tabs" aria-label="Debtors views">
      <a class="<%= isListView ? 'active' : '' %>" href="/reports/debtors?<%= closeParams.toString() %>" <% if (isListView) { %>aria-current="page"<% } %>>Debtors List</a>
      <% if (report.selected) { %>
        <a class="<%= isFullStatement ? 'active' : '' %>" href="/reports/debtors?<%= statementParams.toString() %><%= statementParams.toString() ? '&' : '' %>view=full" <% if (isFullStatement) { %>aria-current="page"<% } %>>Statement · <%= report.selected.customer_name %></a>
      <% } %>
      <% if (report.selected && paymentInvoiceId) { %>
        <a class="<%= isPaymentView ? 'active' : '' %>" href="/reports/debtors?<%= paymentParams.toString() %>" <% if (isPaymentView) { %>aria-current="page"<% } %>>Receive Payment</a>
      <% } %>
    </nav>

    <% if (isListView) { %>
    <form class="report-filters debtor-filters" method="get">
      <label class="debtor-customer-filter">
        <span>Customer:</span>
        <input name="q" value="<%= report.filters.search %>" placeholder="Search debtors" list="statement-customers">
        <datalist id="statement-customers">
          <% (report.customerResults || []).filter((customer) => Number(customer.balance_due) > 0).forEach((customer) => { %>
            <option value="<%= customer.customer_id || customer.customer_name %>"></option>
          <% }) %>
        </datalist>
      </label>
      <label class="debtor-date-filter">
        <span>Invoice from:</span>
        <input type="date" name="from" value="<%= report.filters.from %>" aria-label="From date" title="From date">
      </label>
      <label class="debtor-date-filter">
        <span>Invoice to:</span>
        <input type="date" name="to" value="<%= report.filters.to %>" aria-label="To date" title="To date">
      </label>
      <div class="report-filter-actions">
        <button type="submit">Apply</button>
        <a class="button button-light" href="/reports/debtors">Reset</a>
      </div>
    </form>

    <section class="metrics debtor-metrics" aria-label="Debtors summary">
      <article>
        <span>Debtors</span>
        <strong><%= report.summary.customer_count %></strong>
      </article>
      <article>
        <span>Invoice Total</span>
        <strong><%= money(report.summary.invoice_total) %></strong>
      </article>
      <article>
        <span>Paid</span>
        <strong><%= money(report.summary.paid_total) %></strong>
      </article>
      <article>
        <span>Balance Due</span>
        <strong><%= money(report.summary.balance_due) %></strong>
      </article>
    </section>

    <% if (Number(report.summary.unallocated_balance || 0) !== 0) { %>
      <section class="notice warning">
        <strong>Unallocated Accounts Receivable <%= report.summary.unallocated_balance < 0 ? 'credit' : 'debit' %>: <%= money(Math.abs(report.summary.unallocated_balance)) %></strong>
        <span> This is the all-date general ledger amount without a matching submitted sales invoice. Check journal customer and invoice references in the <a href="/reports/general-ledger?account=Accounts%20Receivable">Accounts Receivable ledger</a>.</span>
      </section>
    <% } %>

    <section class="invoice-card report-section">
      <div class="section-title">
        <h2>Debtor Aging</h2>
      </div>
      <table>
        <thead>
          <tr>
            <th class="row-number">#</th>
            <th>Customer ID</th>
            <th>Invoices</th>
            <th>Current</th>
            <th>1-30</th>
            <th>31-60</th>
            <th>61-90</th>
            <th>Over 90</th>
            <th>Unallocated</th>
            <th>Balance</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!report.debtors.length) { %>
            <tr><td colspan="11" class="empty">No debtor balances found.</td></tr>
          <% } %>
          <% report.debtors.forEach((debtor, index) => { const customerParams = new URLSearchParams(statementParams); customerParams.set('customer', debtor.customer_key); customerParams.delete('view'); %>
            <tr class="debtor-row" data-statement-href="/reports/debtors?<%= customerParams.toString() %>" tabindex="0" role="link" aria-label="Open statement for <%= debtor.customer_name %>">
              <td class="row-number"><%= (report.pagination ? report.pagination.offset : 0) + index + 1 %></td>
              <td>
                <a class="debtor-name" href="/reports/debtors?<%= customerParams.toString() %>"><%= debtor.customer_id || debtor.customer_name %></a>
              </td>
              <td><%= debtor.invoice_count %></td>
              <td><%= money(debtor.current) %></td>
              <td><%= money(debtor.days_1_30) %></td>
              <td><%= money(debtor.days_31_60) %></td>
              <td><%= money(debtor.days_61_90) %></td>
              <td><%= money(debtor.days_over_90) %></td>
              <td><%= money(debtor.unallocated || 0) %></td>
              <td><strong><%= money(debtor.balance_due) %></strong></td>
              <td class="actions-cell">
                <a href="/reports/debtors?<%= customerParams.toString() %>">View</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
        <% if (report.debtors.length) { %>
          <tfoot>
            <tr>
              <th colspan="2">Page total</th>
              <th><%= report.debtors.reduce((sum, row) => sum + Number(row.invoice_count || 0), 0) %></th>
              <th><%= money(report.debtors.reduce((sum, row) => sum + Number(row.current || 0), 0)) %></th>
              <th><%= money(report.debtors.reduce((sum, row) => sum + Number(row.days_1_30 || 0), 0)) %></th>
              <th><%= money(report.debtors.reduce((sum, row) => sum + Number(row.days_31_60 || 0), 0)) %></th>
              <th><%= money(report.debtors.reduce((sum, row) => sum + Number(row.days_61_90 || 0), 0)) %></th>
              <th><%= money(report.debtors.reduce((sum, row) => sum + Number(row.days_over_90 || 0), 0)) %></th>
              <th><%= money(report.debtors.reduce((sum, row) => sum + Number(row.unallocated || 0), 0)) %></th>
              <th><%= money(report.debtors.reduce((sum, row) => sum + Number(row.balance_due || 0), 0)) %></th>
              <th></th>
            </tr>
          </tfoot>
        <% } %>
      </table>
      <%- include('pagination', { pagination: report.pagination, query, basePath: '/reports/debtors' }) %>
    </section>

    <% } %>

    <% if (isFullStatement) { %>
      <section class="invoice-card report-section debtor-full-statement" data-statement data-export-name="<%= report.selected.customer_name %>-statement.csv">
        <div class="section-title statement-heading">
          <div>
            <p class="eyebrow">Statement</p>
            <h2><%= report.selected.customer_name %></h2>
          </div>
          <div class="statement-balance">
            <span>Balance due</span>
            <strong><%= money(report.statementBalance) %></strong>
          </div>
        </div>
        <div class="statement-actions no-print">
          <button type="button" class="button button-light" data-print-statement>Print</button>
          <button type="button" class="button button-light" data-export-statement>Export</button>
          <% if (paymentInvoiceId) { %>
            <a class="button" href="/reports/debtors?<%= paymentParams.toString() %>">Receive Payment</a>
          <% } %>
        </div>
        <%- include('debtor-statement-table', { statement: report.statement, money }) %>
      </section>
    <% } %>

    <% if (isPaymentView) { const paymentInvoice = paymentData.invoice; const paymentDocstatus = paymentInvoice.docstatus || 'submitted'; const paymentHistory = Array.isArray(paymentInvoice.payments) ? paymentInvoice.payments : []; const paymentBalance = Math.max(0, Number(paymentInvoice.total || 0) - Number(paymentInvoice.amount_paid || 0)); %>
      <div class="section-title statement-heading payment-tab-heading">
        <div>
          <p class="eyebrow">Receive payment</p>
          <h2><%= paymentInvoice.customer_name %> · <a href="/invoices/<%= paymentInvoice.id %>" data-voucher-drawer="/invoices/<%= paymentInvoice.id %>/drawer"><%= paymentInvoice.invoice_no %></a></h2>
        </div>
        <div class="statement-balance">
          <span>Balance due</span>
          <strong><%= money(paymentBalance) %></strong>
        </div>
      </div>
      <%- include('invoice-payments', { invoice: paymentInvoice, payments: paymentHistory, docstatus: paymentDocstatus, balanceDue: paymentBalance, today, money, returnTo: paymentReturnTo }) %>
    <% } %>
  </main>

  <% if (report.selected && !isFullStatement && !isPaymentView && query.view !== 'list') { statementParams.set('view', 'full'); %>
    <div class="statement-drawer-layer" data-statement-layer>
      <a class="statement-drawer-backdrop" href="/reports/debtors?<%= closeParams.toString() %>" aria-label="Close statement" data-close-statement></a>
      <aside class="statement-drawer" role="dialog" aria-modal="true" aria-labelledby="statement-drawer-title" data-statement data-export-name="<%= report.selected.customer_name %>-statement.csv" tabindex="-1">
        <header class="statement-drawer-header">
          <div>
            <p class="eyebrow">Customer statement</p>
            <h2 id="statement-drawer-title"><%= report.selected.customer_name %></h2>
            <% if (report.selected.customer_id) { %><small><%= report.selected.customer_id %></small><% } %>
          </div>
          <a class="statement-drawer-close" href="/reports/debtors?<%= closeParams.toString() %>" aria-label="Close statement" data-close-statement>&times;</a>
        </header>
        <div class="statement-drawer-body">
          <div class="statement-balance-card">
            <span>Balance</span>
            <strong><%= money(report.statementBalance) %></strong>
            <small><%= report.selected.invoice_count %> invoice<%= Number(report.selected.invoice_count) === 1 ? '' : 's' %></small>
          </div>
          <form class="statement-date-range" method="get" action="/reports/debtors">
            <input type="hidden" name="customer" value="<%= report.selected.customer_key %>">
            <% if (report.filters.search) { %><input type="hidden" name="q" value="<%= report.filters.search %>"><% } %>
            <label>
              From
              <input type="date" name="statement_from" value="<%= report.filters.statement_from %>">
            </label>
            <label>
              To
              <input type="date" name="statement_to" value="<%= report.filters.statement_to %>">
            </label>
            <button type="submit">Apply</button>
            <% if (report.filters.statement_range_set) { const clearRangeParams = new URLSearchParams(); clearRangeParams.set('customer', report.selected.customer_key); if (report.filters.search) clearRangeParams.set('q', report.filters.search); if (report.filters.from) clearRangeParams.set('from', report.filters.from); if (report.filters.to) clearRangeParams.set('to', report.filters.to); %>
              <a class="button button-light" href="/reports/debtors?<%= clearRangeParams.toString() %>">Clear</a>
            <% } %>
          </form>
          <div class="statement-actions">
            <button type="button" class="button button-light" data-print-statement>Print</button>
            <button type="button" class="button button-light" data-export-statement>Export</button>
            <% if (paymentInvoiceId) { %>
              <a class="button" href="/reports/debtors?<%= paymentParams.toString() %>">Receive Payment</a>
            <% } %>
            <a class="button button-light" href="/reports/debtors?<%= statementParams.toString() %>">Open Full Statement</a>
          </div>
          <section class="statement-transactions">
            <div class="section-title">
              <h3>Transactions</h3>
              <span><%= report.statement.length %> entr<%= report.statement.length === 1 ? 'y' : 'ies' %></span>
            </div>
            <%- include('debtor-statement-table', { statement: report.statement, money }) %>
          </section>
        </div>
      </aside>
    </div>
  <% } %>
  <script src="/debtor-report.js?v=<%= assetVersion %>-date-label-v1" defer></script>
</body>
</html>
