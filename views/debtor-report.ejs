<!doctype html>
<html lang="en">
<head>
  <title>Debtor Report</title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">Reports</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Dashboard', href: '/' }, { label: 'Debtors' }] }) %>
      </div>
      <nav>
        <%- include('module-nav', { activeModule: 'report' }) %>
      </nav>
    </header>
    <form class="report-filters" method="get">
      <label>
        Customer
        <input name="q" value="<%= report.filters.search %>" placeholder="Search debtors" list="statement-customers">
        <datalist id="statement-customers">
          <% (report.customerResults || []).forEach((customer) => { %>
            <option value="<%= customer.customer_name %>"><%= customer.customer_id || customer.customer_name %></option>
          <% }) %>
        </datalist>
      </label>
      <label>
        From
        <input type="date" name="from" value="<%= report.filters.from %>">
      </label>
      <label>
        To
        <input type="date" name="to" value="<%= report.filters.to %>">
      </label>
      <% if (report.filters.customer) { %>
        <input type="hidden" name="customer" value="<%= report.filters.customer %>">
      <% } %>
      <div class="report-filter-actions">
        <button type="submit">Apply</button>
        <a class="button button-light" href="/reports/debtors">Reset</a>
      </div>
    </form>

    <section class="metrics">
      <article>
        <span>Debtors</span>
        <strong><%= report.summary.customer_count %></strong>
      </article>
      <article>
        <span>Invoice Total</span>
        <strong><%= money(report.summary.invoice_total) %></strong>
      </article>
      <article>
        <span>Paid</span>
        <strong><%= money(report.summary.paid_total) %></strong>
      </article>
      <article>
        <span>Balance Due</span>
        <strong><%= money(report.summary.balance_due) %></strong>
      </article>
    </section>

    <section class="invoice-card report-section">
      <div class="section-title">
        <h2>Debtor Aging</h2>
      </div>
      <table>
        <thead>
          <tr>
            <th>Customer</th>
            <th>Invoices</th>
            <th>Current</th>
            <th>1-30</th>
            <th>31-60</th>
            <th>61-90</th>
            <th>Over 90</th>
            <th>Balance</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!report.debtors.length) { %>
            <tr><td colspan="9" class="empty">No debtor balances found.</td></tr>
          <% } %>
          <% report.debtors.forEach((debtor) => { %>
            <tr>
              <td>
                <strong><%= debtor.customer_name %></strong>
                <% if (debtor.customer_id) { %><small><%= debtor.customer_id %></small><% } %>
              </td>
              <td><%= debtor.invoice_count %></td>
              <td><%= money(debtor.current) %></td>
              <td><%= money(debtor.days_1_30) %></td>
              <td><%= money(debtor.days_31_60) %></td>
              <td><%= money(debtor.days_61_90) %></td>
              <td><%= money(debtor.days_over_90) %></td>
              <td><strong><%= money(debtor.balance_due) %></strong></td>
              <td>
                <a href="/reports/debtors?customer=<%= encodeURIComponent(debtor.customer_key) %>&q=<%= encodeURIComponent(report.filters.search) %>&from=<%= encodeURIComponent(report.filters.from) %>&to=<%= encodeURIComponent(report.filters.to) %>">Statement</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
        <% if (report.debtors.length) { %>
          <tfoot>
            <tr>
              <th>Total</th>
              <th><%= report.debtors.reduce((sum, row) => sum + Number(row.invoice_count || 0), 0) %></th>
              <th><%= money(report.summary.current) %></th>
              <th><%= money(report.summary.days_1_30) %></th>
              <th><%= money(report.summary.days_31_60) %></th>
              <th><%= money(report.summary.days_61_90) %></th>
              <th><%= money(report.summary.days_over_90) %></th>
              <th><%= money(report.summary.balance_due) %></th>
              <th></th>
            </tr>
          </tfoot>
        <% } %>
      </table>
    </section>

    <% if (report.filters.search && !report.selected) { %>
      <section class="invoice-card report-section">
        <div class="section-title">
          <h2>Customer Matches</h2>
        </div>
        <table>
          <thead>
            <tr>
              <th>Customer</th>
              <th>Invoices</th>
              <th>Invoice Total</th>
              <th>Paid</th>
              <th>Balance</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% if (!(report.customerResults || []).length) { %>
              <tr><td colspan="6" class="empty">No matching customers found.</td></tr>
            <% } %>
            <% (report.customerResults || []).forEach((customer) => { %>
              <tr>
                <td>
                  <strong><%= customer.customer_name %></strong>
                  <% if (customer.customer_id) { %><small><%= customer.customer_id %></small><% } %>
                </td>
                <td><%= customer.invoice_count %></td>
                <td><%= money(customer.invoice_total) %></td>
                <td><%= money(customer.paid_total) %></td>
                <td><strong><%= money(customer.balance_due) %></strong></td>
                <td>
                  <a href="/reports/debtors?customer=<%= encodeURIComponent(customer.customer_key) %>&q=<%= encodeURIComponent(report.filters.search) %>&from=<%= encodeURIComponent(report.filters.from) %>&to=<%= encodeURIComponent(report.filters.to) %>">Statement</a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    <% } %>

    <% if (report.selected) { %>
      <section class="invoice-card report-section">
        <div class="section-title">
          <div>
            <p class="eyebrow">Statement</p>
            <h2><%= report.selected.customer_name %></h2>
          </div>
          <strong>Balance: <%= money(report.selected.balance_due) %></strong>
        </div>
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Type</th>
              <th>Reference</th>
              <th>Description</th>
              <th>Debit</th>
              <th>Credit</th>
              <th>Balance</th>
            </tr>
          </thead>
          <tbody>
            <% if (!report.statement.length) { %>
              <tr><td colspan="7" class="empty">No statement entries found.</td></tr>
            <% } %>
            <% report.statement.forEach((entry) => { %>
              <tr>
                <td><%= entry.date %></td>
                <td><%= entry.type %></td>
                <td>
                  <% if (entry.invoice_id) { %>
                    <a href="/invoices/<%= entry.invoice_id %>"><%= entry.reference %></a>
                  <% } else { %>
                    <%= entry.reference %>
                  <% } %>
                </td>
                <td><%= entry.description %></td>
                <td><%= entry.debit ? money(entry.debit) : '' %></td>
                <td><%= entry.credit ? money(entry.credit) : '' %></td>
                <td><strong><%= money(entry.balance) %></strong></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </section>
    <% } %>
  </main>
</body>
</html>
