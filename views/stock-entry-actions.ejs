<% const entryStatus = entry.docstatus || 'submitted'; %>
<% const actionBase = entry.entry_type === 'reconciliation' ? 'reconciliations' : 'entries'; %>
<% const actionLabel = entry.entry_type === 'reconciliation' ? 'stock reconciliation' : 'stock entry'; %>
<% const actionSharedOnly = typeof sharedAccessOnly !== 'undefined' && sharedAccessOnly; %>
<% const canCreate = can('vouchers.stock.create')
  && (currentUser.role === 'admin' || currentUser.scopes?.suppliers?.mode !== 'selected'); %>
<% const editPath = entry.entry_type === 'reconciliation'
  ? `/stock/reconciliations/${entry.id}/edit` : `/stock/entries/${entry.id}/edit`; %>
<% const duplicateHref = entry.entry_type === 'reconciliation'
  ? `/stock/reconciliations/${entry.id}/duplicate` : `/stock/entries/${entry.id}/duplicate`; %>
<% if (entry.id && !actionSharedOnly && can('vouchers.stock.view')) { %>
  <a class="button button-light" href="/stock/<%= actionBase %>/<%= entry.id %>/print" target="_blank" rel="noopener">Print</a>
<% } %>
<% if (entry.id && !actionSharedOnly && entryStatus === 'submitted' && can('vouchers.stock.cancel')) { %>
  <form method="post" action="/stock/<%= actionBase %>/<%= entry.id %>/cancel" class="inline-form"
    data-confirm="Cancel this <%= actionLabel %>? Its stock and accounting effects will be reversed.">
    <button type="submit" class="button-light">Cancel</button>
  </form>
<% } %>
<% if (entry.id && !actionSharedOnly
    && (entry.entry_type === 'reconciliation'
      || ['opening', 'purchase', 'adjustment', ...stockTransferTypes].includes(entry.entry_type))
    && can('vouchers.stock.view') && canCreate) { %>
  <a class="button button-light" href="<%= duplicateHref %>">Duplicate</a>
<% } %>
<% if (actionSharedOnly && entryStatus === 'draft' && typeof sharedWriteAccess !== 'undefined' && sharedWriteAccess) { %>
  <a class="button button-light" href="<%= editPath %>">Edit</a>
<% } else if (!actionSharedOnly) { %>
  <% if (entryStatus === 'draft' && can('vouchers.stock.edit')) { %><a class="button button-light" href="<%= editPath %>"><%= entry.entry_type === 'reconciliation' ? 'Edit count' : 'Edit' %></a><% } %>
  <% if (entryStatus === 'draft' && can('vouchers.stock.delete')) { %><form method="post" action="<%= entry.entry_type === 'reconciliation' ? `/stock/reconciliations/${entry.id}/delete` : `/stock/entries/${entry.id}/delete` %>" class="inline-form" data-confirm="Delete this draft stock voucher? This cannot be undone."><button type="submit" class="button-light">Delete Draft</button></form><% } %>
  <% if (entryStatus === 'draft' && can('vouchers.stock.submit') && (entry.entry_type !== 'cancel' || can('vouchers.stock.cancel'))) { %><form method="post" action="<%= entry.entry_type === 'reconciliation' ? `/stock/reconciliations/${entry.id}/submit` : `/stock/entries/${entry.id}/submit` %>" class="inline-form" data-confirm="Submit this stock voucher? Its saved quantities and rates will be posted to stock and accounting."><button type="submit"><%= entry.entry_type === 'reconciliation' ? 'Submit reconciliation' : 'Submit' %></button></form><% } %>
  <% if (entryStatus === 'cancelled' && currentUser.role === 'admin') { %><form method="post" action="<%= entry.entry_type === 'reconciliation' ? `/stock/reconciliations/${entry.id}/delete` : `/stock/entries/${entry.id}/delete` %>" class="inline-form" data-confirm="Delete this cancelled stock voucher? Its ledger and stock reversal history will remain. This cannot be undone."><button type="submit" class="button-light">Delete Voucher</button></form><% } %>
<% } %>
