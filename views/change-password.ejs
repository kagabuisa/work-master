<!doctype html>
<html lang="en">
<head>
  <title>Change password · Work Master</title>
  <%- include('partials-head') %>
</head>
<body class="auth-page">
  <main class="auth-card">
    <%- include('auth-brand') %>
    <h1>Change password</h1>
    <% if (currentUser.must_change_password) { %><p>Set your own password to continue.</p><% } %>
    <% if (error) { %><p class="auth-error" role="alert"><%= error %></p><% } %>
    <form method="post" action="/account/password">
      <label for="current_password">Current password</label>
      <input id="current_password" name="current_password" type="password" autocomplete="current-password" required autofocus>
      <label for="new_password">New password</label>
      <input id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="12" required>
      <label for="confirm_password">Confirm new password</label>
      <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="12" required>
      <button type="submit">Save password</button>
    </form>
    <% if (!currentUser.must_change_password) { %><p><a href="/">Back to dashboard</a></p><% } %>
  </main>
</body>
</html>
