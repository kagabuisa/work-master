<div class="invoice-drawer-content" data-voucher-title="<%= entry.entry_no %>" data-voucher-eyebrow="<%= entry.entry_type === 'reconciliation' ? 'Stock Reconciliation' : 'Stock Entry' %>">
  <div class="invoice-drawer-heading">
    <div>
      <p class="eyebrow"><%= entry.entry_type === 'reconciliation' ? 'Stock Reconciliation' : 'Stock Entry' %></p>
      <small><%= stockEntryTypeLabels[entry.entry_type] || entry.entry_type %></small>
    </div>
  </div>
  <div class="invoice-drawer-actions">
    <%- include('stock-entry-actions', { entry }) %>
  </div>
  <%- include('stock-entry-detail', { entry, items, money }) %>
</div>
