<!doctype html>
<html lang="en">
<head>
  <title>Work Master</title>
  <%- include('partials-head') %>
</head>
<body class="home-page">
  <main class="shell home-shell ui-page ui-page-dashboard">
    <section class="home-directory" aria-labelledby="home-directory-title">
      <header class="ui-dashboard-header">
      <div class="ui-dashboard-brand">
        <img src="/work-master-logo.svg" width="48" height="48" alt="">
        <h1 id="home-directory-title">Work Master <span>- Work Starts Here</span></h1>
      </div>
        <%- include('account-bar', { showPasswordLink: false }) %>
      </header>

      <% if (sections.length) { %>
        <div class="ui-dashboard-grid">
          <% sections.forEach((section) => { %>
            <%- include('ui-module-card', { module: section }) %>
          <% }) %>
        </div>
      <% } else { %>
        <div class="ui-surface ui-dashboard-empty">No sections are available for your account yet.</div>
      <% } %>
    </section>
  </main>
</body>
</html>
