<% if(can('hr.leave.create')){ %>
<section class="invoice-card hr-card hr-leave-request-card">
  <div class="hr-leave-heading"><div><p class="hr-section-eyebrow">New request</p><h2>Request leave</h2></div><span class="hr-plan-count">Saved as draft</span></div>
  <p class="hr-section-description">Choose an employee, leave type, and dates, then add a reason.</p>
  <form method="post" action="/hr/leave" class="hr-leave-request-form" data-static-labels>
    <div class="hr-leave-fields">
      <%- include('hr-employee-select',{label:'Employee',name:'employee_id',multiple:false,activeOnly:true}) %>
      <label>Leave type<select name="leave_type_id" required><option value="">Choose type</option><% opts.leaveTypes.forEach(t=>{ %><option value="<%= t.id %>"><%= t.name %> (<%= t.is_paid?'paid':'unpaid' %>)</option><% }) %></select></label>
      <label>From<input type="date" name="from_date" required></label>
      <label>To<input type="date" name="to_date" required></label>
    </div>
    <label class="hr-leave-half-day"><input type="checkbox" name="half_day" value="1"><span>Half day <small>Use the same start and end date.</small></span></label>
    <label class="hr-leave-reason">Reason<textarea name="reason" required maxlength="2000" rows="3" placeholder="Briefly explain the reason for this leave request."></textarea></label>
    <div class="hr-leave-save"><p>Holidays are excluded. Split requests that cross calendar years. A different user approves the request; Admin can approve directly.</p><button class="button" type="submit">Save request</button></div>
  </form>
</section>
<% } %>
<section class="invoice-card hr-card"><h2>Requests</h2><div class="table-wrap"><table><thead><tr><th>Employee</th><th>Type</th><th>Dates</th><th>Days</th><th>Reason</th><th>Status</th><th>Actions</th></tr></thead><tbody><% requests.forEach(r=>{ %><tr><td><%= r.employee_name %></td><td><%= r.leave_type %></td><td><%= formatDate(r.from_date) %> – <%= formatDate(r.to_date) %></td><td><%= r.days %></td><td><%= r.reason %></td><td><%= r.docstatus==='submitted'?'Approved':r.docstatus %></td><td class="hr-actions"><% if(r.docstatus==='draft'&&can('hr.leave.submit')){ %><form method="post" action="/hr/leave/<%= r.id %>/submit"><button class="button secondary">Approve</button></form><% } %><% if(r.docstatus!=='cancelled'&&can('hr.leave.cancel')){ %><form method="post" action="/hr/leave/<%= r.id %>/cancel"><button class="button secondary">Cancel</button></form><% } %></td></tr><% }) %></tbody></table></div></section>
<section class="invoice-card hr-card"><h2>Leave balances</h2><table><thead><tr><th>Employee</th><th>Type</th><th>Year</th><th>Allocated</th><th>Approved</th><th>Available</th></tr></thead><tbody><% balances.forEach(b=>{ %><tr><td><%= b.employee_name %></td><td><%= b.leave_type %></td><td><%= b.year %></td><td><%= b.days %></td><td><%= b.used_days %></td><td><%= Number(b.days)-Number(b.used_days) %></td></tr><% }) %></tbody></table>
<% if(can('hr.leave.edit')){ %><details><summary>Set an employee’s annual allocation</summary><form method="post" action="/hr/leave/allocations" class="hr-grid hr-leave-allocation-form" data-static-labels><%- include('hr-employee-select',{label:'Employee',name:'employee_id',multiple:false,activeOnly:true}) %><label>Type<select name="leave_type_id" required><% opts.leaveTypes.forEach(t=>{ %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select></label><label>Year<input type="number" min="1900" max="2200" name="year" value="<%= today.slice(0,4) %>" required></label><label>Annual days<input type="number" name="days" min="0.5" step="0.5" required></label><label>Allocation reason<input name="notes" maxlength="2000"></label><div><button class="button">Save allocation</button></div></form></details><% } %></section>
