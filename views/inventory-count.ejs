<% const canEditCount=can('inventory.count.save')&&(count.state==='counting'||currentUser.role==='admin'&&['awaiting_review','approved'].includes(count.state)); %>
<!doctype html><html lang="en"><head><title><%= count.entry_no %></title><%- include('partials-head') %></head><body><main class="shell ui-page ui-page-form">
<header class="topbar"><%- include('breadcrumbs',{breadcrumbs:[{label:'Home',href:'/'},{label:'Stock Reconciliation',href:'/stock/reconciliations'},{label:count.entry_no}]}) %><%- include('module-nav',{activeModule:'stock'}) %></header>
<%- include('stock-reconciliation-tabs',{activeReconciliationTab:'counts'}) %>
<% if(error) { %><p class="error" role="alert"><%= error %></p><% } %>
<section class="ui-surface">
<%- include('ui-section-heading',{heading:{title:count.entry_no,meta:({counting:'Counting · warehouse frozen',awaiting_review:'Awaiting approval · warehouse frozen',approved:'Approved · awaiting submission',submitted:'Submitted',abandoned:'Abandoned'})[count.state]||count.state,help:'The server fixes the cut-off. Inventory posting stays frozen until reconciliation submits or the count is abandoned. Submitted closing boundaries cannot be reopened.'}}) %>
<div class="ui-voucher-attributes ui-attributes-compact">
<p><span>Warehouse</span><strong><%= count.warehouse %></strong></p>
<p><span>Cut-off · Kampala</span><strong><%= stamp(count.cutoff) %></strong></p>
<p><span>Revision</span><strong data-count-revision><%= count.revision %></strong></p>
<p><span>Prepared by</span><strong><%= count.preparer %></strong></p>
<p><span>Reviewed by</span><strong><%= count.reviewer||'Awaiting approval' %></strong></p>
<p><span>Submitted · Kampala</span><strong><%= count.submitted_at?stamp(count.submitted_at):'Pending' %></strong></p>
</div>
<div class="ui-toolbar"><span class="field-hint">Readiness confirmed</span><%- include('ui-helper',{helpLabel:'Readiness confirmation',helpText:count.readiness||'No readiness statement recorded.'}) %><% if(count.reason) { %><span class="field-hint">Review / abandonment: <%= count.reason %></span><% } %>
<% if(count.state==='submitted') { %><a class="button button-light" href="/reports/stock-ledger?reference=<%= count.entry_no %>">View posted stock ledger</a><% } %></div>
</section>
<section class="ui-surface" id="count-effect-dashboard" aria-label="Count effect dashboard">
<% const effectSummary=countEffects.summarize(lines); %>
<div class="ui-section-heading"><div class="ui-section-title"><h2>Count effect</h2><%- include('ui-helper',{helpLabel:'About count effects',helpText:'Enter each physical quantity explicitly, including zero, and explain discrepancies. Preview totals include entered counts only; blanks are not zero. Gains use the entered valuation rate and losses use the frozen book rate. Quantities sum units across items. Save count changes before requesting review.'}) %></div><span class="ui-section-meta" data-count-progress><%= effectSummary.counted %> / <%= effectSummary.total %> counted<%= effectSummary.pending?' · '+effectSummary.pending+' pending':'' %><%= effectSummary.valuationPending?' · '+effectSummary.valuationPending+' rates needed':'' %><%= effectSummary.pending||effectSummary.valuationPending?' · Partial preview':' · Preview' %></span></div>
<div class="metrics ui-report-metrics ui-metrics-compact ui-metrics-three" aria-label="Count effect statistics">
<% [['Quantity gained','qtyGained'],['Quantity lost','qtyLost'],['Net quantity','qtyNet'],['Value gained · UGX','valueGained'],['Value lost · UGX','valueLost'],['Net value · UGX','valueNet']].forEach(([label,key])=>{ %><article class="<%= key.endsWith('Net')?'ui-metric-focus':'' %>"><span><%= label %></span><strong data-count-effect="<%= key %>"><%= key.startsWith('qty')?countEffects.formatQuantity(effectSummary[key]):countEffects.formatAmount(effectSummary[key]) %></strong></article><% }); %>
</div>
</section>
<form method="post" action="/stock/reconciliations/counts/<%= count.id %>/save" class="ui-surface" id="inventory-count-form" data-voucher-form data-prevent-enter-submit data-item-lookup="/stock/reconciliations/counts/<%= count.id %>/items"><input type="hidden" name="revision" value="<%= count.revision %>">
<%- include('ui-section-heading',{heading:{title:'Physical counts',help:'Enter every physical quantity explicitly, including zero, and explain discrepancies. Save count changes before requesting review.'}}) %>
<div class="ui-table-scroll"><table class="editable"><thead><tr><th>Item</th><th>Book qty</th><th>Book value</th><th>Physical qty</th><th>Gain valuation rate</th><th>Difference</th><th>Proposed value change</th><th>Explanation</th></tr></thead><tbody id="count-item-rows"><% lines.forEach(l=>{ const lineEffect=countEffects.lineEffect(l); %><tr data-book-qty="<%= l.book_qty %>" data-book-value="<%= l.book_value %>" data-book-rate="<%= l.book_rate %>"><td><%= l.item_code %><input type="hidden" name="item_code" value="<%= l.item_code %>"></td><td><%= l.book_qty %></td><td><%= l.book_value %></td><td><input aria-label="Physical quantity for <%= l.item_code %>" type="number" min="0" step="0.001" name="counted_qty" value="<%= l.counted_qty===null?'':l.counted_qty %>" <%= canEditCount?'':'disabled' %>></td><td><input aria-label="Gain valuation rate for <%= l.item_code %>" type="number" min="0" step="1" name="valuation_rate" value="<%= l.valuation_rate %>" <%= canEditCount?'':'disabled' %>></td><td data-line-effect="quantity"><%= lineEffect.counted?countEffects.formatQuantity(lineEffect.quantity):'Not counted' %></td><td data-line-effect="value"><%= !lineEffect.counted?'Not counted':lineEffect.value===null?'Rate required':countEffects.formatAmount(lineEffect.value) %></td><td><input aria-label="Explanation for <%= l.item_code %>" name="explanation" value="<%= l.explanation %>" <%= canEditCount?'':'disabled' %>></td></tr><% }) %></tbody></table></div>
<% if(canEditCount) { %><div class="ui-form-footer"><button type="submit" data-voucher-save>Save count revision</button></div><% } %></form>
<% if(count.state==='counting'&&can('inventory.count.save')) { %><form id="found-item-form" class="ui-surface" method="post" action="/stock/reconciliations/counts/<%= count.id %>/found-item"><input type="hidden" name="revision" value="<%= count.revision %>"><fieldset class="ui-form-section"><legend>Found item not in book stock (optional)</legend><div class="ui-toolbar ui-filter-row"><label>Item code<input name="found_item" list="found-item-options" autocomplete="off" placeholder="Search item code or name"><datalist id="found-item-options"></datalist></label><label>Physical quantity<input type="number" min="0" step="0.001" name="found_quantity"></label><label>Valuation rate<input type="number" min="0" step="1" name="found_rate"></label><label>Explanation<input name="found_reason"></label><button type="submit" class="button-light" id="add-found-item">Add found item</button></div><p class="muted" id="found-item-status" role="status" aria-live="polite"></p></fieldset></form><% } %>
<div class="ui-toolbar"><span class="field-hint">Evidence and revisions</span><%- include('ui-helper',{helpLabel:'Evidence and revisions',helpText:'Changing supporting evidence advances the revision and invalidates approval. After an upload, reload the latest revision before saving counts or requesting review. Save unfinished count edits before uploading or importing.'}) %></div>
<div class="ui-panel-grid" aria-label="Count sheets and supporting documents">
<%- include('reconciliation-attachments',{saved:true,entry:{id:count.reconciliation_id},compactUploads:true,canManage:!['submitted','abandoned'].includes(count.state)&&can('inventory.count.save'),attachmentEndpoint:`/stock/reconciliations/counts/${count.id}/attachments`}) %>
<section class="ui-surface ui-upload-card"><%- include('ui-section-heading',{heading:{title:'Excel count sheet',eyebrow:'Count quantities',help:'Download uses this frozen snapshot and revision. Import saves a new revision; blank quantities remain incomplete. Review explanations and rates afterward.'}}) %>
<p class="ui-upload-intro">Fill the downloaded template, then upload your counted quantities.</p>
<ol class="ui-upload-summary ui-upload-steps" aria-label="Excel count workflow"><li><span>1</span>Download</li><li><span>2</span>Enter counts</li><li><span>3</span>Upload</li></ol>
<% const canImportCount=!['submitted','abandoned'].includes(count.state)&&can('inventory.count.save'); %>
<form id="count-sheet-import" method="post" action="/stock/reconciliations/counts/<%= count.id %>/sheet" enctype="multipart/form-data" class="ui-upload-form">
<label class="ui-upload-field">Completed Excel sheet<input type="file" name="count_sheet" accept=".xlsx" required <%= canImportCount?'':'disabled' %> aria-describedby="count-sheet-import-help"></label>
<p class="field-hint" id="count-sheet-import-help"><% if(canImportCount) { %>XLSX · Maximum 5 MB · Import saves a new revision and clears any approval.<% } else if(['submitted','abandoned'].includes(count.state)) { %>This count is closed. Its quantities cannot be imported or changed.<% } else { %>Count Save permission is required to import quantities.<% } %></p>
<div class="ui-form-footer"><a class="button button-light" href="/stock/reconciliations/counts/<%= count.id %>/sheet">Download count sheet</a><button type="submit" <%= canImportCount?'':'disabled' %>>Import counts into table</button></div>
</form>
</section></div>
<section class="ui-surface" id="count-review">
<%- include('ui-section-heading',{heading:{title:'Review and completion',help:'Submission posts the reconciliation and permanently closes inventory history through the cut-off. Returning for recount clears approval and keeps the warehouse frozen.'}}) %>
<div class="ui-action-row">
<% const actions=count.state==='counting'?['review']:count.state==='awaiting_review'?['approve','reject']:count.state==='approved'?['submit','reject']:[]; actions.forEach(action=>{if(can(`inventory.count.${action}`)&&!(action==='approve'&&currentUser.role!=='admin'&&audit.some(a=>String(a.actor_id)===String(currentUser.id)&&['start','save','evidence_changed'].includes(a.action)))){ %>
<form method="post" action="/stock/reconciliations/counts/<%= count.id %>/<%= action %>" class="ui-action-form <%= action==='reject'?'ui-action-form-secondary':'' %>"><input type="hidden" name="revision" value="<%= count.revision %>">
<% if(action==='reject'){ %><label>Recount reason<input name="reason" required minlength="3" placeholder="Why is a recount needed?"></label><% } %>
<button type="submit" class="<%= action==='reject'?'button-light':'' %>"><%= {review:'Request review',approve:'Approve this revision',submit:'Submit reconciliation and close history',reject:'Return for recount'}[action] %></button></form><% }}) %>
<% if(!actions.length) { %><p class="field-hint">This reconciliation is <%= count.state %>. No further review actions are available.</p><% } %>
</div>
<% if(!['submitted','abandoned'].includes(count.state)&&can('inventory.count.abandon')) { %><details class="ui-secondary-action"><summary>Abandon this count</summary><form method="post" action="/stock/reconciliations/counts/<%= count.id %>/abandon" class="ui-action-form"><input type="hidden" name="revision" value="<%= count.revision %>"><label>Abandonment reason<input name="reason" required minlength="10"></label><button type="submit" class="button-light" data-confirm="Abandon this count permanently and release the warehouse without creating a closure?">Abandon count</button></form></details><% } %>
</section>
<section class="ui-surface ui-results"><%- include('ui-section-heading',{heading:{title:'Audit trail'}}) %><div class="ui-table-scroll"><table class="ui-table"><thead><tr><th>Date/time (Kampala)</th><th>Action</th><th>Actor</th><th>Revision</th></tr></thead><tbody><% audit.forEach(a=>{ %><tr><td><%= stamp(a.at) %></td><td><%= a.action %></td><td><%= a.username %></td><td><%= a.revision %></td></tr><% }) %></tbody></table></div></section>
</main><script src="/shared/invoice-math.js?v=<%= assetVersion %>" defer></script><script src="/count-effects.js?v=<%= assetVersion %>" defer></script><script src="/inventory-count.js?v=<%= assetVersion %>" defer></script><script src="/reconciliation-attachments.js?v=<%= assetVersion %>"></script></body></html>
