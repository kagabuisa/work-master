<details class="ui-download-menu">
  <summary class="button button-light">Download <span aria-hidden="true">▾</span></summary>
  <div class="ui-filter-panel ui-download-options" role="group" aria-label="Download format">
    <% const downloadFormats = typeof formats !== 'undefined' ? formats : ['csv', 'xlsx', 'pdf']; %>
    <% downloadFormats.forEach(format => { %>
      <button type="submit" name="format" value="<%= format %>" class="button-light" <% if (typeof downloadAction !== 'undefined') { %>formaction="<%= downloadAction %>"<% } %> <% if (typeof downloadRequiresSelection !== 'undefined' && downloadRequiresSelection) { %>data-multi-select-submit<% } %>><%= { csv: 'CSV', xlsx: 'Excel', pdf: 'PDF' }[format] %></button>
    <% }) %>
  </div>
</details>
