<% const payrollForm = typeof formData !== 'undefined' ? formData : {}; const selectedEmployees = Array.isArray(payrollForm.employee_ids) ? payrollForm.employee_ids : [payrollForm.employee_ids].filter(Boolean); %>
<% if(typeof payrollError !== 'undefined' && payrollError){ %>
<section class="notice warning" role="alert"><p><%= payrollError %></p>
<% if(correctionHref){ %><a class="button button-light" href="<%= correctionHref %>"><%= correctionLabel %></a><% } %>
</section>
<% } %>
<% if(can('hr.payroll.create')){ %>
<section class="invoice-card hr-card ui-surface"><%- include('ui-section-heading', { heading: { title: 'Prepare monthly payroll', help: 'Save each employee’s pay plan effective on or before the first day of the payroll month. Payroll Write is required to save pay plans. Review paid days, variable pay, and recoveries before posting. Inactive employees need a leaving date in their employment profile.' } }) %>
<% if(can('hr.employees.view')){ %><a class="inline-link hr-payroll-setup" href="/hr/employees">Set up employee pay plans ↗</a><% } %>
<form method="post" action="/hr/payroll" class="hr-grid ui-form-grid hr-payroll-preparation">
<label>Company<select name="company" required><option value="">Choose company</option><% [...new Set(opts.employees.filter(e=>e.status==='Active'&&!e.disabled).map(e=>e.company).filter(Boolean))].sort().forEach(company=>{ %><option <%= payrollForm.company===company?'selected':'' %>><%= company %></option><% }) %></select></label>
<label>Payroll month<input type="month" name="period" value="<%= payrollForm.period||today.slice(0,7) %>" required></label>
<%- include('voucher-posting-fields', { postingFields: { date: payrollForm.posting_date || today } }) %>
<%- include('hr-employee-select',{label:'Employees (choose the same company)',name:'employee_ids',multiple:true,activeOnly:true,selectedIds:selectedEmployees}) %>
<div><button class="button">Create draft payroll</button></div></form>
</section><% } %>
<section class="invoice-card hr-card ui-surface"><%- include('ui-section-heading', { heading: { title: 'Payroll register' } }) %><a class="button secondary" href="/hr/payslips">Individual payslips</a><div class="table-wrap ui-table-scroll"><table class="ui-table"><thead><tr><th>Payroll</th><th>Company</th><th>Employees</th><th>Gross</th><th>Net</th><th>Paid</th><th>Outstanding</th><th>Status</th></tr></thead><tbody><% runs.forEach(r=>{ %><tr><td><a href="/hr/payroll/<%= r.id %>">PAY-<%= r.id %> · <%= r.period %></a></td><td><%= r.company %></td><td><%= r.employees %></td><td class="ui-amount"><%= money(r.gross) %></td><td class="ui-amount"><%= money(r.net) %></td><td class="ui-amount"><%= money(r.paid) %></td><td class="ui-amount"><%= r.docstatus==='submitted'?money(r.net-r.paid):'—' %></td><td><span class="badge <%= r.docstatus %>"><%= r.docstatus %></span></td></tr><% }) %></tbody></table></div><% if(!runs.length){ %><p>No payroll runs in your permitted scope.</p><% } %></section>
