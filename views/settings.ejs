<!doctype html>
<html lang="en">
<head>
  <title>Settings</title>
  <%- include('partials-head') %>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">Setup</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Home', href: '/' }, { label: 'Settings' }] }) %>
      </div>
      <nav>
        <%- include('module-nav', { activeModule: 'settings' }) %>
      </nav>
    </header>

    <% if (currentUser.role === 'admin') { %><%- include('settings-tabs', { activeSettingsTab: 'general' }) %><% } %>

    <section class="grid settings-grid">
      <% if (currentUser.role === 'admin') { %>
      <div class="settings-company-card">
        <div class="section-title"><h2>Company Information</h2></div>
        <p class="muted-text">These details appear on sales invoice previews and printouts.</p>
        <% if (companySaved) { %><section class="notice sync-notice" role="status">Company information saved.</section><% } %>
        <% if (companyError) { %><section class="notice warning" role="alert"><%= companyError %></section><% } %>
        <form method="post" action="/settings/company-information">
          <div class="form-grid">
            <label class="wide">Company Name<input name="name" value="<%= company.name || '' %>" maxlength="200" required autocomplete="organization"></label>
            <label class="wide">Address<textarea name="address" rows="3" maxlength="1000" autocomplete="street-address"><%= company.address || '' %></textarea></label>
            <label>Phone<input name="phone" type="tel" value="<%= company.phone || '' %>" maxlength="100" autocomplete="tel"></label>
            <label>Email<input name="email" type="email" value="<%= company.email || '' %>" maxlength="254" autocomplete="email"></label>
            <label>Website<input name="website" value="<%= company.website || '' %>" maxlength="254" placeholder="www.example.com"></label>
            <label>Tax ID / TIN<input name="tax_id" value="<%= company.tax_id || '' %>" maxlength="100"></label>
            <label>Registration Number<input name="registration_number" value="<%= company.registration_number || '' %>" maxlength="100"></label>
          </div>
          <div class="actions"><button type="submit">Save Company Information</button></div>
          <%- include('record-audit', { record: company }) %>
        </form>
      </div>

      <div class="settings-company-card">
        <div class="section-title"><h2>Date and Time Format</h2></div>
        <p class="muted-text">Choose how dates and times appear in vouchers and reports.</p>
        <% if (dateTimeSaved) { %><section class="notice sync-notice" role="status">Date and time format saved.</section><% } %>
        <% if (dateTimeError) { %><section class="notice warning" role="alert"><%= dateTimeError %></section><% } %>
        <form method="post" action="/settings/date-time">
          <div class="form-grid">
            <label>Date Format
              <select name="date_format" required>
                <option value="YYYY-MM-DD" <%= dateTimeSettings.date_format === 'YYYY-MM-DD' ? 'selected' : '' %>>YYYY-MM-DD (2026-09-29)</option>
                <option value="DD/MM/YYYY" <%= dateTimeSettings.date_format === 'DD/MM/YYYY' ? 'selected' : '' %>>DD/MM/YYYY (29/09/2026)</option>
                <option value="MM/DD/YYYY" <%= dateTimeSettings.date_format === 'MM/DD/YYYY' ? 'selected' : '' %>>MM/DD/YYYY (09/29/2026)</option>
                <option value="DD-MM-YYYY" <%= dateTimeSettings.date_format === 'DD-MM-YYYY' ? 'selected' : '' %>>DD-MM-YYYY (29-09-2026)</option>
              </select>
            </label>
            <label>Time Format
              <select name="time_format" required>
                <option value="24h" <%= dateTimeSettings.time_format === '24h' ? 'selected' : '' %>>24-hour (19:40)</option>
                <option value="12h" <%= dateTimeSettings.time_format === '12h' ? 'selected' : '' %>>12-hour (7:40 PM)</option>
              </select>
            </label>
          </div>
          <div class="actions"><button type="submit">Save Date and Time Format</button></div>
        </form>
      </div>

      <% } %>
      <% if (can('sync.run')) { %>
      <div class="settings-sync-card">
        <div class="section-title">
          <h2>ERPNext Sync</h2>
          <form method="post" action="/settings/erpnext-sync/sales-invoices">
            <button type="submit" <%= salesInvoiceSync.running ? 'disabled' : '' %>>
              <%= salesInvoiceSync.running ? 'Importing...' : 'Import Sales Invoices' %>
            </button>
          </form>
        </div>
        <p class="muted-text">Sales invoices from <strong><%= salesInvoiceSync.import_from %></strong> going forward.</p>
        <% if (salesInvoiceSync.query_status === 'success' && salesInvoiceSync.last && salesInvoiceSync.last.ok) { %>
          <section class="notice sync-notice">
            <strong>Import completed.</strong>
            <p>
              ERPNext invoices: <%= salesInvoiceSync.last.summary.mysql_invoices %>,
              newly imported: <%= salesInvoiceSync.last.summary.imported %>,
              already present: <%= salesInvoiceSync.last.summary.skipped_existing || 0 %>,
              skipped without items: <%= salesInvoiceSync.last.summary.skipped_no_items %>,
              new paid rows: <%= salesInvoiceSync.last.summary.paid_rows_created %>.
            </p>
          </section>
        <% } else if (salesInvoiceSync.query_status === 'failed' && salesInvoiceSync.last) { %>
          <section class="notice warning">
            <strong>Import failed.</strong>
            <p><%= salesInvoiceSync.last.message %></p>
          </section>
        <% } else if (salesInvoiceSync.query_status === 'running') { %>
          <section class="notice warning">
            <strong>Import already running.</strong>
            <p>Please wait for the current import to finish.</p>
          </section>
        <% } else if (salesInvoiceSync.last) { %>
          <p class="muted-text">
            Last run:
            <%= salesInvoiceSync.last.finished_at ? formatTimestamp(salesInvoiceSync.last.finished_at) : 'Not finished' %>
            <% if (salesInvoiceSync.last.ok && salesInvoiceSync.last.summary) { %>
              · Newly imported <%= salesInvoiceSync.last.summary.imported %> invoices
              · Already present <%= salesInvoiceSync.last.summary.skipped_existing || 0 %>
            <% } else if (salesInvoiceSync.last.message) { %>
              · <%= salesInvoiceSync.last.message %>
            <% } %>
          </p>
        <% } else { %>
          <p class="muted-text">No in-app import has been run since the app started.</p>
        <% } %>
      </div>
      <% } %>
      <% if (can('masters.items.view')) { %>
      <div>
        <div class="section-title">
          <h2>Items</h2>
          <% if (can('masters.items.create')) { %><a class="button" href="/settings/items/new">Add</a><% } %>
        </div>
        <a href="/settings/items">Open Items</a>
      </div>
      <% } %>
      <% if (can('masters.price-lists.view') || canManageNamedPriceLists) { %>
      <div>
        <div class="section-title">
          <h2>Price Lists</h2>
          <% if (can('masters.price-lists.create')) { %><a class="button" href="/settings/price-lists/new">Add</a><% } %>
        </div>
        <a href="/settings/price-lists">Open Price Lists</a>
      </div>
      <% } %>
      <% if (can('masters.item-prices.view') || canCreateItemPrice) { %>
      <div>
        <div class="section-title">
          <h2>Item Prices</h2>
          <% if (canCreateItemPrice) { %><a class="button" href="/settings/item-prices/new">Add</a><% } %>
        </div>
        <a href="/settings/item-prices">Open Item Prices</a>
      </div>
      <% } %>
      <% if (can('masters.suppliers.view')) { %>
      <div>
        <div class="section-title">
          <h2>Suppliers</h2>
          <% if (can('masters.suppliers.create')) { %><a class="button" href="/settings/suppliers/new">Add</a><% } %>
        </div>
        <a href="/settings/suppliers">Open Suppliers</a>
      </div>
      <% } %>
      <% if (can('masters.customers.view')) { %>
      <div>
        <div class="section-title">
          <h2>Customers</h2>
          <% if (can('masters.customers.create')) { %><a class="button" href="/settings/customers/new">Add</a><% } %>
        </div>
        <a href="/settings/customers">Open Customers</a>
      </div>
      <% } %>
      <% if (can('masters.warehouses.view') || canViewNamedWarehouses) { %>
      <div>
        <div class="section-title">
          <h2>Warehouses</h2>
          <% if (can('masters.warehouses.create')) { %><a class="button" href="/settings/warehouses/new">Add</a><% } %>
        </div>
        <a href="/settings/warehouses">Open Warehouses</a>
      </div>
      <% } %>
      <% if (can('masters.employees.view') || canViewAssignedEmployees) { %>
      <div>
        <div class="section-title">
          <h2>Employees</h2>
          <% if (can('masters.employees.create')) { %><a class="button" href="/settings/employees/new">Add</a><% } %>
        </div>
        <a href="/settings/employees">Open Employees</a>
      </div>
      <% } %>
      <% if (can('masters.cost-centers.view') || canViewAssignedCostCenters) { %>
      <div>
        <div class="section-title">
          <h2>Cost Centers</h2>
          <% if (can('masters.cost-centers.create')) { %><a class="button" href="/settings/cost-centers/new">Add</a><% } %>
        </div>
        <a href="/settings/cost-centers">Open Cost Centers</a>
      </div>
      <% } %>
      <% if (can('masters.options.view')) { %>
      <div>
        <div class="section-title">
          <h2>Options</h2>
          <% if (can('masters.options.create')) { %><a class="button" href="/settings/options/new">Add</a><% } %>
        </div>
        <a href="/settings/options">Open Options</a>
      </div>
      <% } %>
    </section>
  </main>
</body>
</html>
