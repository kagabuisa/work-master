<!doctype html><html lang="en"><head><title>Stock Reconciliation — Counts</title><%- include('partials-head') %></head><body>
<main class="shell ui-page ui-page-list ui-list-compact">
<header class="topbar"><%- include('breadcrumbs',{breadcrumbs:[{label:'Home',href:'/'},{label:'Stock',href:'/stock/entries'},{label:'Counts and warehouse closure'}]}) %><nav><a class="button button-light" href="/stock/entries">Stock entries</a><% if(can('inventory.correction.view')) { %><a class="button button-light" href="/stock/reconciliations/corrections">Corrections</a><% } %></nav><%- include('module-nav',{activeModule:'stock'}) %></header>
<%- include('stock-reconciliation-tabs',{activeReconciliationTab:'counts'}) %>
<% if(error) { %><p class="error" role="alert"><%= error %></p><% } %>
<% if(!enabled) { %><section class="ui-surface"><p>Controlled inventory is installed but has not been activated. An operator must complete database/runtime setup before counts can start. Existing reconciliations have not established closing boundaries.</p></section><% } %>
<section class="ui-surface ui-results"><%- include('ui-section-heading',{heading:{title:'Warehouse controls',help:'Physical movements must stop and all preceding movements must be submitted before starting a count. A count freezes posting until approved reconciliation commits, or the count is explicitly abandoned.'}}) %>
<div class="ui-table-scroll"><table class="ui-table"><thead><tr><th>Warehouse</th><th>Status</th><th>Closed through (Kampala)</th></tr></thead><tbody><% warehouses.forEach(w=>{ %><tr><td><%= w.warehouse %></td><td><% if(w.active_count) { %><a href="/stock/reconciliations/counts/<%= w.active_count %>">Frozen — count <%= w.active_count %></a><% } else { %>Open<% } %></td><td><%= stamp(w.closed_through) %></td></tr><% }) %></tbody></table></div></section>
<% if(enabled && can('inventory.count.start')) { %><form method="post" action="/stock/reconciliations/counts" class="ui-surface" id="start-count">
<%- include('ui-section-heading',{heading:{title:'Start a physical count'}}) %><div class="ui-form-grid"><label>Warehouse<select name="warehouse" required><option value="">Choose warehouse</option><% warehouses.filter(w=>!w.active_count).forEach(w=>{ %><option><%= w.warehouse %></option><% }) %></select></label>
<label>Readiness confirmation<textarea name="readiness" required minlength="10" placeholder="Confirm physical movements stopped and all preceding transactions were submitted."></textarea></label></div>
<div class="ui-form-footer"><button type="submit" data-confirm="Freeze this warehouse and establish the server-generated physical count cut-off?">Start count and freeze warehouse</button></div></form><% } %>
<section class="ui-surface ui-results"><%- include('ui-section-heading',{heading:{title:'Count sessions',meta:'Latest 200 sessions'}}) %><div class="ui-table-scroll"><table class="ui-table"><thead><tr><th>Count</th><th>Warehouse</th><th>Cut-off (Kampala)</th><th>State</th><th>Revision</th></tr></thead><tbody><% counts.forEach(c=>{ %><tr><td><a href="/stock/reconciliations/counts/<%= c.id %>"><%= c.entry_no %></a></td><td><%= c.warehouse %></td><td><%= stamp(c.cutoff) %></td><td><%= c.state %></td><td><%= c.revision %></td></tr><% }) %><% if(!counts.length) { %><tr><td colspan="5" class="empty">No count sessions.</td></tr><% } %></tbody></table></div></section>
<section class="ui-surface ui-results"><%- include('ui-section-heading',{heading:{title:'Pending drafts to review',help:'These drafts have no stock effect. Verify that physically completed movements are submitted before starting the count. A draft for a future movement may remain a draft.'}}) %><div class="ui-table-scroll"><table class="ui-table"><thead><tr><th>Type</th><th>Reference</th><th>Warehouse</th></tr></thead><tbody><% pending.forEach(p=>{ %><tr><td><%= p.kind %></td><td><%= p.reference %></td><td><%= p.warehouse %></td></tr><% }) %><% if(!pending.length) { %><tr><td colspan="3" class="empty">No pending drafts found.</td></tr><% } %></tbody></table></div></section>
</main></body></html>
