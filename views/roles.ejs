<!doctype html>
<html lang="en">
<head>
  <title>Permissions · Work Master</title>
  <%- include('partials-head') %>
  <script src="/roles.js?v=<%= assetVersion %>-granular-v2" defer></script>
</head>
<body>
  <main class="shell">
    <header class="topbar">
      <div>
        <p class="eyebrow">Administration</p>
        <%- include('breadcrumbs', { breadcrumbs: [{ label: 'Home', href: '/' }, { label: 'Settings', href: '/settings' }, { label: activeTab === 'roles' ? 'Roles' : 'Permissions' }] }) %>
      </div>
      <nav><%- include('module-nav', { activeModule: 'settings' }) %></nav>
    </header>
    <%- include('settings-tabs', { activeSettingsTab: 'roles' }) %>
    <% if (error) { %><section class="notice warning" role="alert"><strong><%= error %></strong></section><% } %>
    <% if (notice) { %><section class="notice" role="status"><strong><%= notice %></strong></section><% } %>

    <nav class="module-tabs" aria-label="Permission settings">
      <a href="/settings/roles?tab=roles" <%= activeTab === 'roles' ? 'aria-current="page"' : '' %>>Roles</a>
      <a href="/settings/roles" <%= activeTab === 'permissions' ? 'aria-current="page"' : '' %>>Role permissions</a>
      <a href="/settings/roles?tab=users" <%= activeTab === 'users' ? 'aria-current="page"' : '' %>>User permissions</a>
    </nav>

    <% if (activeTab === 'permissions') { %>
    <section class="invoice-card report-section permission-page">
      <div class="section-title"><h1>Role permissions</h1><a href="/settings/users">Assign roles to users</a></div>
      <p class="permission-intro">Choose a role and tick its allowed actions. Changes save automatically; untick Read to remove a permission row.</p>
      <details class="permission-help"><summary>How record permissions work</summary><p>For a named price list, Read allows use in eligible sales or purchase vouchers, Create adds item prices to it, Write edits it, Submit activates it, Cancel deactivates it, and Delete removes it. For an individual warehouse or account, Read allows it to appear in lists and be used in vouchers.</p></details>
      <form method="get" action="/settings/roles" class="role-picker">
        <label>Search roles <input type="search" id="role-search" placeholder="Type a role name" autocomplete="off"></label>
        <label>Role <select name="role" id="role-select" required>
          <% roles.forEach((role) => { %><option value="<%= role.slug %>" <%= selectedRole?.slug === role.slug ? 'selected' : '' %>><%= role.name %><%= role.built_in ? ' · built in' : '' %></option><% }) %>
        </select></label>
        <button type="submit">Open role</button>
      </form>
    </section>

    <% if (selectedRole) { %>
      <section class="invoice-card report-section permission-page">
        <div class="section-title"><h2><%= selectedRole.name %></h2><span class="muted-text"><%= selectedRole.user_count %> user<%= selectedRole.user_count === 1 ? '' : 's' %></span></div>
        <% if (selectedRole.slug === 'admin') { %>
          <p>Admin has full access. Its permissions cannot be changed.</p>
        <% } else { %>
          <% const configuredTypes = recordTypes.filter((type) => type.actions.some((action) => selectedRole.permissions.includes(type.permissions[action]))); %>
          <div class="role-table-wrap"><table class="role-permission-table" data-auto-permissions>
            <thead><tr><th>Permission type</th><th>Create</th><th>Read</th><th>Write</th><th>Submit</th><th>Cancel</th><th>Delete</th></tr></thead>
            <tbody>
              <% if (!configuredTypes.length) { %><tr><td colspan="7" class="empty">No record permissions yet. Add the first row below.</td></tr><% } %>
              <% configuredTypes.forEach((type, index) => { const formId = `role-row-${index}`; %>
                <tr>
                  <td data-label="Permission type"><strong><%= type.label %></strong><form id="<%= formId %>" method="post" action="/settings/roles/<%= selectedRole.slug %>/permissions"><input type="hidden" name="record_type" value="<%= type.key %>"></form></td>
                  <% recordActions.forEach((action) => { %>
                    <td class="role-check-cell" data-label="<%= action === 'view' ? 'Read' : action === 'edit' ? 'Write' : action[0].toUpperCase() + action.slice(1) %>"><% if (type.actions.includes(action)) { %><label><input type="checkbox" form="<%= formId %>" name="actions" value="<%= action %>" data-permission="<%= type.permissions[action] %>" aria-label="<%= action %> <%= type.label %>" <%= selectedRole.permissions.includes(type.permissions[action]) ? 'checked' : '' %>></label><% } else { %><span aria-label="Not applicable">—</span><% } %></td>
                  <% }) %>
                </tr>
              <% }) %>
            </tbody>
          </table></div>
          <p role="status" aria-live="polite" data-permission-status>Changes to the checkboxes above save automatically.</p>
            <form method="post" action="/settings/roles/<%= selectedRole.slug %>/permissions" class="role-add-row" data-role-add-row>
              <input type="hidden" name="record_type" data-record-type>
              <label>Voucher or master list <select required data-permission-type>
                <option value="">Select a type</option>
                <% [...new Set(recordTypes.filter((type) => !type.parentKey).map((type) => type.group))].forEach((group) => { %>
                  <optgroup label="<%= group %>">
                    <% recordTypes.filter((type) => !type.parentKey && type.group === group).forEach((type) => { %><option value="<%= type.key %>" data-permissions="<%= JSON.stringify(type.permissions) %>" data-actions="<%= type.actions.join(',') %>" data-granted-actions="<%= type.actions.filter((action) => selectedRole.permissions.includes(type.permissions[action])).join(',') %>"><%= type.label %></option><% }) %>
                  </optgroup>
                <% }) %>
              </select></label>
              <label>Specific record (optional) <select data-granular-record disabled>
                <option value="">Select a type first</option>
                <% recordTypes.filter((type) => type.parentKey).forEach((type) => { %><option value="<%= type.key %>" data-parents="<%= [type.parentKey, ...(type.parentAliases || [])].join(',') %>" data-permissions="<%= JSON.stringify(type.permissions) %>" data-actions="<%= type.actions.join(',') %>" data-granted-actions="<%= type.actions.filter((action) => selectedRole.permissions.includes(type.permissions[action])).join(',') %>"><%= type.label %></option><% }) %>
              </select></label>
              <div class="role-add-actions" aria-label="Actions">
                <% recordActions.forEach((action) => { %><label><input type="checkbox" name="actions" value="<%= action %>"> <%= action === 'view' ? 'Read' : action === 'edit' ? 'Write' : action[0].toUpperCase() + action.slice(1) %></label><% }) %>
              </div>
              <button type="submit">Save permission row</button>
            </form>
        <% } %>
      </section>
      <% if (selectedRole.slug !== 'admin') { %>
        <section class="invoice-card report-section permission-page">
          <h2>Other access</h2>
          <form method="post" action="/settings/roles/<%= selectedRole.slug %>/permissions/extra" class="role-form">
            <div class="role-extra-list">
              <% extraPermissions.forEach((permission) => { %><label><input type="checkbox" name="permissions" value="<%= permission.key %>" <%= selectedRole.permissions.includes(permission.key) ? 'checked' : '' %>> <%= permission.label %></label><% }) %>
            </div>
            <button type="submit">Save other access</button>
          </form>
        </section>
      <% } %>
    <% } %>
    <% } else if (activeTab === 'roles') { %>
      <section class="invoice-card report-section">
        <div class="section-title"><h1>Roles</h1><a href="/settings/users">Assign roles to users</a></div>
        <p>Manage role names and open each role's permissions. Built-in roles have fixed names; unused custom roles can be deleted.</p>
        <div class="table-wrap"><table>
          <thead><tr><th>Role</th><th>Users</th><th>Permissions</th><th>Manage</th></tr></thead>
          <tbody>
            <% roles.forEach((role) => { %>
              <tr>
                <td><strong><%= role.name %></strong><% if (role.built_in) { %><span class="muted-text"> · Built in</span><% } %></td>
                <td><%= role.user_count %></td>
                <td><a href="/settings/roles?role=<%= encodeURIComponent(role.slug) %>">Open permissions</a></td>
                <td>
                  <% if (!role.built_in) { %>
                    <form method="post" action="/settings/roles/<%= role.slug %>" class="role-form">
                      <label class="visually-hidden" for="role-name-<%= role.slug %>">Name for <%= role.name %></label>
                      <input id="role-name-<%= role.slug %>" name="name" value="<%= role.name %>" minlength="3" maxlength="64" required>
                      <button type="submit" class="button-light">Rename</button>
                    </form>
                    <% if (role.user_count === 0) { %><form method="post" action="/settings/roles/<%= role.slug %>/delete" data-confirm="Delete this unused role?"><button type="submit" class="button-light">Delete</button></form><% } %>
                  <% } else { %><span class="muted-text">Fixed name</span><% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table></div>
      </section>
      <section class="invoice-card report-section">
        <h2>Add role</h2>
        <form method="post" action="/settings/roles" class="role-form">
          <label>Role name <input name="name" placeholder="For example, Stock Supervisor" minlength="3" maxlength="64" required></label>
          <button type="submit">Create role</button>
        </form>
      </section>
    <% } else { %>
      <section class="invoice-card report-section permission-page">
        <div class="section-title"><h1>User permissions</h1><a href="/settings/users">Manage users</a></div>
        <p class="permission-intro">Choose a user and tick their allowed actions. Changes save automatically; untick Read to remove a permission row.</p>
        <details class="permission-help"><summary>How user permissions work</summary><p>User choices override the role; the role supplies access where no override is set. Active price lists, including buying lists, are available as permission types. Read allows a price list's use in eligible sales or purchase vouchers. For an individual warehouse or account, Read allows it to appear in lists and be used in vouchers. Edit a user's default selections on their Edit user page.</p></details>
        <form method="get" action="/settings/roles" class="role-picker">
          <input type="hidden" name="tab" value="users">
          <label>Search users <input type="search" id="user-search" placeholder="Type a username" autocomplete="off"></label>
          <label>User <select name="user" required>
            <% users.forEach((user) => { %><option value="<%= user.id %>" <%= selectedUser && Number(selectedUser.id) === Number(user.id) ? 'selected' : '' %>><%= user.username %></option><% }) %>
          </select></label>
          <button type="submit">Open user</button>
        </form>
      </section>
      <% if (selectedUser) { %>
        <section class="invoice-card report-section permission-page">
          <div class="section-title"><h2><%= selectedUser.username %></h2><span class="muted-text">Role: <%= selectedUserRole?.name || selectedUser.role %></span></div>
          <% if (selectedUser.role === 'admin') { %>
            <p>Admin has full access. Its permissions cannot be changed.</p>
          <% } else { %>
            <% const configuredTypes = recordTypes.filter((type) => type.actions.some((action) => userPermissions.includes(type.permissions[action]))); %>
            <div class="role-table-wrap"><table class="role-permission-table" data-auto-permissions>
              <thead><tr><th>Permission type</th><th>Create</th><th>Read</th><th>Write</th><th>Submit</th><th>Cancel</th><th>Delete</th></tr></thead>
              <tbody>
                <% if (!configuredTypes.length) { %><tr><td colspan="7" class="empty">No record permissions yet. Add the first row below.</td></tr><% } %>
                <% configuredTypes.forEach((type, index) => { const formId = `user-row-${index}`; %>
                  <tr>
                    <td data-label="Permission type"><strong><%= type.label %></strong><% if (defaultUserPermissionKeys.includes(type.permissions.view)) { %> <a class="permission-default-link" href="/settings/users/<%= selectedUser.id %>/edit">Edit default</a><% } %><form id="<%= formId %>" method="post" action="/settings/users/<%= selectedUser.id %>/permissions/row"><input type="hidden" name="record_type" value="<%= type.key %>"></form></td>
                    <% recordActions.forEach((action) => { %>
                      <td class="role-check-cell" data-label="<%= action === 'view' ? 'Read' : action === 'edit' ? 'Write' : action[0].toUpperCase() + action.slice(1) %>"><% if (type.actions.includes(action)) { %><label><input type="checkbox" form="<%= formId %>" name="actions" value="<%= action %>" data-permission="<%= type.permissions[action] %>" <%= action === 'view' && defaultUserPermissionKeys.includes(type.permissions.view) ? 'data-default-read' : '' %> aria-label="<%= action %> <%= type.label %>" <%= userPermissions.includes(type.permissions[action]) ? 'checked' : '' %>></label><% } else { %><span aria-label="Not applicable">—</span><% } %></td>
                    <% }) %>
                  </tr>
                <% }) %>
              </tbody>
            </table></div>
            <p role="status" aria-live="polite" data-permission-status>Changes to the checkboxes above save automatically.</p>
            <form method="post" action="/settings/users/<%= selectedUser.id %>/permissions/row" class="role-add-row" data-role-add-row>
              <input type="hidden" name="record_type" data-record-type>
              <label>Voucher or master list <select required data-permission-type>
                <option value="">Select a type</option>
                <% [...new Set(recordTypes.filter((type) => !type.parentKey).map((type) => type.group))].forEach((group) => { %>
                  <optgroup label="<%= group %>">
                    <% recordTypes.filter((type) => !type.parentKey && type.group === group).forEach((type) => { %><option value="<%= type.key %>" data-permissions="<%= JSON.stringify(type.permissions) %>" data-actions="<%= type.actions.join(',') %>" data-granted-actions="<%= type.actions.filter((action) => userPermissions.includes(type.permissions[action])).join(',') %>"><%= type.label %></option><% }) %>
                  </optgroup>
                <% }) %>
              </select></label>
              <label>Specific record (optional) <select data-granular-record disabled>
                <option value="">Select a type first</option>
                <% recordTypes.filter((type) => type.parentKey).forEach((type) => { %><option value="<%= type.key %>" data-parents="<%= [type.parentKey, ...(type.parentAliases || [])].join(',') %>" data-permissions="<%= JSON.stringify(type.permissions) %>" data-actions="<%= type.actions.join(',') %>" data-granted-actions="<%= type.actions.filter((action) => userPermissions.includes(type.permissions[action])).join(',') %>"><%= type.label %></option><% }) %>
              </select></label>
              <div class="role-add-actions" aria-label="Actions">
                <% recordActions.forEach((action) => { %><label><input type="checkbox" name="actions" value="<%= action %>"> <%= action === 'view' ? 'Read' : action === 'edit' ? 'Write' : action[0].toUpperCase() + action.slice(1) %></label><% }) %>
              </div>
              <button type="submit">Save permission row</button>
            </form>
          <% } %>
        </section>
        <% if (selectedUser.role !== 'admin') { %>
          <section class="invoice-card report-section permission-page">
            <h2>Other access</h2>
            <form method="post" action="/settings/users/<%= selectedUser.id %>/permissions/extra" class="role-form">
              <div class="role-extra-list">
                <% extraPermissions.forEach((permission) => { %><label><input type="checkbox" name="permissions" value="<%= permission.key %>" <%= userPermissions.includes(permission.key) ? 'checked' : '' %>> <%= permission.label %></label><% }) %>
              </div>
              <button type="submit">Save other access</button>
            </form>
          </section>
          <section class="invoice-card report-section permission-page">
            <h2>Role defaults</h2>
            <p>Reset this user's permissions to the current <%= selectedUserRole?.name || selectedUser.role %> role.</p>
            <form method="post" action="/settings/users/<%= selectedUser.id %>/permissions/reset" data-confirm="Reset all user permission overrides for <%= selectedUser.username %>?"><button type="submit" class="button-light">Reset to role permissions</button></form>
          </section>
        <% } %>
      <% } %>
    <% } %>
  </main>
</body>
</html>
