<form method="post" action="<%= action %>" class="hr-grid ui-form-grid">
<% if(typeof slipId!=='undefined'){ %><input type="hidden" name="slip_id" value="<%= slipId %>"><% } %>
<label><span class="hr-control-label">Amount (UGX)</span><input type="number" name="amount" min="0.01" step="0.01" max="<%= maximum %>" value="<%= maximum %>" required></label>
<%- include('voucher-posting-fields', { postingFields: { date: today, label: 'Payment Date' } }) %>
<%- include('hr-account-select',{label:'Cash / bank account',name:'bank_account_id',types:['asset'],bank:true,selected:'',required:true}) %>
<label><span class="hr-control-label">Reference</span><input name="reference" required maxlength="2000" placeholder="Bank reference or receipt number"></label>
<div><button class="button"><%= buttonLabel %></button></div></form>
