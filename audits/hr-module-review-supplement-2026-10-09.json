  "live_salary_scripts": [
    {
      "dt": "Salary Slip",
      "script": "frappe.ui.form.on(\"Salary Slip\", {\n\tvalidate: function(frm) {\n\t\tfrm.trigger(\"calculate_commission2\")\n\t},\n\n\tsales: function(frm) {\n\t\tfrm.trigger(\"calculate_commission2\")\n\t},\n\n\tmargin: function(frm) {\n\t\tfrm.trigger(\"calculate_commission2\")\n\t},\n\n\tcalculate_commission2: function(frm) {\n\t\tif (frm.doc.sales && frm.doc.margin){ \n\t\t\tcommission = flt(frm.doc.sales * frm.doc.margin * 12500 / 20 / 1000000);\n\t\t\tfrm.set_value('commission2', commission)\n                        refresh_field(\"commission2\");\n\t\t}\n\t}\n})\n\ncur_frm.add_fetch('salary_slip','balance_cf','balance_bf')\ncur_frm.add_fetch('salary_slip','employee_name','employee2')\ncur_frm.add_fetch('salary_slip','month','month2')\n\nfunction compute(doc, cdt, cdn){\n    if (doc.balance_bf && doc.grand_total && doc.deducted){ //it's check if the fields contains a value\n          doc.balance_cf = doc.balance_bf + doc.grand_total - doc.deducted;\n          refresh_field(\"balance_cf\");\n    }\n    else {\n        if (doc.grand_total && doc.deducted){\n            doc.balance_cf = doc.grand_total - doc.deducted;\n            refresh_field(\"balance_cf\"); \n         }\n         else {\n            if (doc.balance_bf && doc.grand_total){\n              doc.balance_cf = doc.balance_bf + doc.grand_total;\n              refresh_field(\"balance_cf\");\n              }\n              else {\n                  if (doc.grand_total){\n                     doc.balance_cf = doc.grand_total;\n                     refresh_field(\"balance_cf\");\n                     }\n                     else {\n                          if (doc.balance_cf){\n                             doc.balance_cf = doc.balance_bf - doc.deducted;\n                             refresh_field(\"balance_cf\");\n                           }\n                           else {\n                                if (doc.balance_bf){\n                                   doc.balance_cf = doc.balance_bf;\n                                   refresh_field(\"balance_cf\");\n                                }\n                                else {\n                                     doc.balance_cf = -doc.deducted;\n                                     refresh_field(\"balance_cf\");\n                                     }\n                                }\n                          }\n                      }\n                  }\n            }\n       }\n            \t\t\ncur_frm.cscript.custom_balance_bf = compute;\ncur_frm.cscript.custom_grand_total = compute;\ncur_frm.cscript.custom_deducted = compute;\ncur_frm.cscript.custom_balance_cf = compute;"
    }
  ],
